      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Secure Upload Form -->
        <div class="lg:col-span-2 glass-card p-6 rounded-2xl border-slate-200/80 shadow-sm space-y-4">
          <h2 class="text-base font-display font-bold text-slate-900">Secure Document Rectification Upload</h2>
          <p class="text-xs text-slate-500">Submit rectified documents with Fernet AES-128 encryption at rest and instant pre-validation:</p>
          
          <form id="upload-rect-form" onsubmit="handleApplicantUpload(event)" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1.5">Application Dossier</label>
              <select id="upload-app-id" required class="w-full text-xs px-3.5 py-2.5 border border-slate-300 rounded-xl bg-white shadow-sm focus:ring-2 focus:ring-brand-500 font-mono">
                <option value="APP-2026-SIT01">APP-2026-SIT01 (Sunrise Institute of Technology)</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1.5">Document Category</label>
              <select id="upload-doc-type" required class="w-full text-xs px-3.5 py-2.5 border border-slate-300 rounded-xl bg-white shadow-sm focus:ring-2 focus:ring-brand-500">
                <option value="auto">Auto-Detect from Content (OCR Text Analysis)</option>
                <option value="NOC-Fire">NOC-Fire (Fire Safety Certificate)</option>
                <option value="NOC-Affiliating University">NOC-Affiliating University</option>
                <option value="Accreditation certificate">Accreditation certificate (NBA / NAAC)</option>
                <option value="TER payment receipt">TER payment receipt</option>
                <option value="Building plan">Building plan & Occupancy Certificate</option>
              </select>
            </div>

            <!-- Quick Samples Bar in Applicant Portal -->
            <div class="flex flex-wrap items-center gap-2 pt-1">
              <span class="text-[11px] text-slate-500 font-medium">Test Real Document:</span>
              <button type="button" onclick="loadSampleDocApplicant('Sample_Fire_NOC_Valid.pdf', 'NOC-Fire')" class="px-2.5 py-1 text-[11px] font-bold bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-300 rounded-lg transition">Valid Fire NOC</button>
              <button type="button" onclick="loadSampleDocApplicant('Sample_Fire_NOC_Expired.pdf', 'NOC-Fire')" class="px-2.5 py-1 text-[11px] font-bold bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-300 rounded-lg transition">Expired Fire NOC</button>
              <button type="button" onclick="loadSampleDocApplicant('Sample_Affiliation_Order_Valid.pdf', 'NOC-Affiliating University')" class="px-2.5 py-1 text-[11px] font-bold bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-300 rounded-lg transition">Affiliation Order</button>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1.5">Select File (PDF, JPG, PNG - Max 25MB)</label>
              <input type="file" id="upload-file-input" required accept=".pdf,.png,.jpg,.jpeg" class="w-full text-xs p-2.5 border border-slate-300 rounded-xl bg-white shadow-sm">
              <p id="applicant-selected-filename" class="text-[11px] text-indigo-600 mt-1 font-mono hidden"></p>
            </div>

            <button type="submit" class="w-full py-3 bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold rounded-xl shadow-glow-blue transition-all">
              Encrypt & Submit Rectified Document
            </button>
          </form>

          <div id="upload-result-box" class="p-3.5 bg-emerald-50 text-emerald-800 rounded-xl text-xs hidden border border-emerald-200">
            <!-- Upload status -->
          </div>
        </div>

