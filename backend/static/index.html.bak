    <!-- ------------------------------------------------------------ -->
    <!-- VIEW 3: DOCUMENT INTELLIGENCE & BOUNDING BOX VIEWER          -->
    <!-- ------------------------------------------------------------ -->
    <section id="view-docviewer" class="space-y-6 hidden">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-slate-200">
        <div>
          <h1 class="text-2xl font-display font-bold text-slate-900">Document Intelligence & Evidence Bounding Boxes</h1>
          <p class="text-xs text-slate-500">Coordinate-level visual provenance highlighting discrepancies on original statutory filings</p>
        </div>
        <div class="flex items-center gap-3">
          <select id="docviewer-select" onchange="loadDocInViewer(this.value)" class="text-xs px-3.5 py-2 border border-slate-300 rounded-xl bg-white shadow-sm focus:ring-2 focus:ring-brand-500">
            <option value="">Select Document to Inspect...</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        
        <!-- Document Canvas View (3 Cols) -->
        <div class="lg:col-span-3 glass-card p-6 rounded-2xl border-slate-200/80 bg-slate-900 flex flex-col items-center justify-center min-h-[650px] relative overflow-hidden">
          
          <!-- Zoom Controls Floating Bar -->
          <div class="absolute top-4 right-4 bg-slate-800/90 backdrop-blur border border-slate-700 rounded-xl px-3 py-1.5 flex items-center gap-3 text-xs text-slate-300 shadow-lg z-20">
            <button onclick="adjustZoom(-0.1)" class="hover:text-white font-bold px-1">−</button>
            <span id="zoom-level-text" class="font-mono text-[11px]">100%</span>
            <button onclick="adjustZoom(0.1)" class="hover:text-white font-bold px-1">+</button>
            <button onclick="resetZoom()" class="hover:text-white text-[10px] pl-1 border-l border-slate-600">Reset</button>
          </div>

          <div id="doc-canvas-container" class="relative bg-white shadow-2xl rounded-xl p-8 max-w-full overflow-auto transition-transform duration-200">
            <!-- Simulated Statutory Certificate Page -->
            <div id="pdf-mock-page" class="relative w-[580px] min-h-[760px] bg-white border border-slate-300 p-8 shadow-inner text-slate-800 text-xs font-mono select-none">
              
              <div class="border-b-2 border-slate-800 pb-3 mb-6 text-center">
                <div class="text-[10px] uppercase tracking-widest text-slate-400 font-bold mb-1">GOVERNMENT OF INDIA • STATUTORY FILING</div>
                <h3 id="pdf-title" class="text-base font-display font-black uppercase tracking-wider text-slate-900">STATE FIRE AND EMERGENCY SERVICES</h3>
                <p class="text-[11px] text-slate-600 mt-0.5">National Capital Territory of Delhi / State Directorate</p>
              </div>

              <div id="pdf-body" class="space-y-4 leading-relaxed font-sans text-slate-700">
                <!-- Text blocks rendered dynamically -->
              </div>

              <!-- Overlaid Bounding Box Layer -->
              <div id="pdf-bbox-layer" class="absolute inset-0 pointer-events-none">
                <!-- Highlight box rendered via JS -->
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Linked Findings & Reviewer Feedback Loop (1 Col) -->
        <div class="space-y-6">
          <div class="glass-card p-5 rounded-2xl border-slate-200/80 shadow-sm">
            <h3 class="text-sm font-display font-bold text-slate-900 mb-2">Linked Evidence Findings</h3>
            <p class="text-xs text-slate-500 mb-3">Click any finding to pinpoint its coordinate bounding box on the statutory document:</p>
            <div id="doc-linked-findings" class="space-y-2 text-xs">
              <!-- Linked finding cards -->
            </div>
          </div>

          <div class="glass-card p-5 rounded-2xl border-slate-200/80 shadow-sm">
            <h4 class="text-xs font-display font-bold text-slate-900 uppercase tracking-wider mb-1">Human Officer Feedback Loop</h4>
            <p class="text-[11px] text-slate-500 mb-3">Verify or reject assistive detection to calibrate future confidence:</p>
            <div class="flex gap-2">
              <button onclick="markCurrentFinding('Confirmed')" class="flex-1 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition-all shadow-sm">
                Confirm Flag
              </button>
              <button onclick="markCurrentFinding('False positive')" class="flex-1 py-2 bg-slate-700 hover:bg-slate-800 text-white text-xs font-bold rounded-xl transition-all shadow-sm">
                False Positive
              </button>
            </div>
            <textarea id="finding-comment" placeholder="Optional rationale / notes for audit record..." class="w-full text-xs p-3 mt-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 bg-slate-50"></textarea>
          </div>
        </div>

      </div>
    </section>

    <!-- ------------------------------------------------------------ -->
    <!-- VIEW 4: CLAIM-TO-EVIDENCE KNOWLEDGE GRAPH                    -->
    <!-- ------------------------------------------------------------ -->
    <section id="view-graph" class="space-y-6 hidden">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-slate-200">
