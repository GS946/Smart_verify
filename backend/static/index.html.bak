<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AICTE SmartVerify AI - Intelligent Decision-Support Scrutiny Platform</title>
  
  <!-- Modern Typography: Outfit (Headings & Display), Plus Jakarta Sans (UI Body), JetBrains Mono (Hashes & Codes) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    // -------------------------------------------------------------
    // MODAL & SAMPLE DOCUMENT UPLOAD CONTROLLERS
    // -------------------------------------------------------------
    function openUploadModal(appId = null) {
      const modal = document.getElementById('upload-modal');
      const appSelect = document.getElementById('modal-upload-app-id');
      const targetId = appId || (currentAppDetail ? currentAppDetail.application.id : (allApplications.length ? allApplications[0].id : 'APP-2026-SIT01'));
      
      if (allApplications.length) {
        appSelect.innerHTML = allApplications.map(a => 
          `<option value="${a.id}" ${a.id === targetId ? 'selected' : ''}>${a.id} — ${a.institution_name} (${a.risk_band} Priority)</option>`
        ).join('');
      } else {
        appSelect.innerHTML = `<option value="${targetId}" selected>${targetId}</option>`;
      }
      
      document.getElementById('modal-upload-file').value = '';
      document.getElementById('modal-selected-filename').classList.add('hidden');
      document.getElementById('modal-upload-result').classList.add('hidden');
      modal.classList.remove('hidden');
    }

    function closeUploadModal() {
      document.getElementById('upload-modal').classList.add('hidden');
    }

    async function loadSampleDoc(filename, docType) {
      try {
        const res = await fetch(`/static/samples/${filename}`);
        if (!res.ok) throw new Error('Sample file not found on server');
        const blob = await res.blob();
        const file = new File([blob], filename, { type: 'application/pdf' });
        const dt = new DataTransfer();
        dt.items.add(file);
        const fileInput = document.getElementById('modal-upload-file');
        fileInput.files = dt.files;
        
        document.getElementById('modal-upload-doc-type').value = docType;
        const fnEl = document.getElementById('modal-selected-filename');
        fnEl.innerText = `Selected Sample: ${filename} (${(blob.size / 1024).toFixed(1)} KB)`;
        fnEl.classList.remove('hidden');
        showToast(`Loaded sample: ${filename}`, 'info');
      } catch (err) {
        showToast('Failed to load sample: ' + err.message, 'error');
      }
    }

    async function loadSampleDocApplicant(filename, docType) {
      try {
        const res = await fetch(`/static/samples/${filename}`);
        if (!res.ok) throw new Error('Sample file not found');
        const blob = await res.blob();
        const file = new File([blob], filename, { type: 'application/pdf' });
        const dt = new DataTransfer();
        dt.items.add(file);
        const fileInput = document.getElementById('upload-file-input');
        fileInput.files = dt.files;
        
        document.getElementById('upload-doc-type').value = docType;
        const fnEl = document.getElementById('applicant-selected-filename');
        if (fnEl) {
          fnEl.innerText = `Selected Sample: ${filename} (${(blob.size / 1024).toFixed(1)} KB)`;
          fnEl.classList.remove('hidden');
        }
        showToast(`Loaded sample: ${filename}`, 'info');
      } catch (err) {
        showToast('Failed to load sample: ' + err.message, 'error');
      }
    }

    async function handleModalUpload(e) {
      e.preventDefault();
      const appId = document.getElementById('modal-upload-app-id').value;
      const docType = document.getElementById('modal-upload-doc-type').value;
      const fileInput = document.getElementById('modal-upload-file');
      const resBox = document.getElementById('modal-upload-result');
      const submitBtn = document.getElementById('modal-upload-btn');
      
      if (!fileInput.files.length) {
        showToast('Please select a file to upload', 'error');
        return;
      }
      
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="animate-spin">⏳</span> Ingesting...';
      resBox.classList.remove('hidden');
      resBox.className = 'p-3.5 rounded-xl text-xs bg-indigo-50 text-indigo-900 border border-indigo-200';
      resBox.innerHTML = '<div class="flex items-center gap-2 font-medium"><span>⚡</span> Executing AES-128 encryption, SHA-256 fingerprint, OCR extraction & rule re-evaluation...</div>';
      
      try {
        const fd = new FormData();
        fd.append('application_id', appId);
        fd.append('doc_type', docType);
        fd.append('file', fileInput.files[0]);
        
        const res = await authFetch(`${API_BASE}/documents/upload`, {
          method: 'POST',
          body: fd
        });
        const data = await res.json();
        
        if (!res.ok) throw new Error(data.detail || 'Upload failed');
        
        resBox.className = 'p-3.5 rounded-xl text-xs bg-emerald-50 text-emerald-900 border border-emerald-200 space-y-1';
        resBox.innerHTML = `
          <div class="font-bold text-emerald-800 text-sm">✓ Ingestion & Rule Evaluation Complete!</div>
          <div class="text-[11px] text-slate-700 leading-relaxed font-mono">
            • Doc ID: <strong class="text-emerald-700">${data.document_id}</strong><br>
            • SHA-256: <span class="text-slate-600">${data.sha256.substring(0, 24)}...</span><br>
            • Category: <strong class="text-indigo-700">${data.doc_type}</strong><br>
            • Extracted Fields: <strong class="text-slate-900">${data.extracted_fields && data.extracted_fields.length ? data.extracted_fields.join(', ') : 'validity_date'}</strong>
          </div>
        `;
        showToast('Document ingested & scrutiny rules refreshed!', 'success');
        
        await loadApplications();
        await openDetail(appId, false);
        setTimeout(() => {
          closeUploadModal();
          navigate('detail');
        }, 1500);
      } catch (err) {
        resBox.className = 'p-3.5 rounded-xl text-xs bg-rose-50 text-rose-900 border border-rose-200';
        resBox.innerHTML = `<strong>Upload Failed:</strong> ${err.message || err}`;
        showToast('Upload failed: ' + (err.message || err), 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Ingest & Re-Scrutinize';
      }
    }

    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            display: ['Outfit', 'sans-serif'],
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          },
          colors: {
            brand: {
              50: '#f0f7ff',
              100: '#e0effe',
              200: '#bae0fd',
              300: '#7cc5fb',
              400: '#38a5f8',
              500: '#0e87eb',
              600: '#026bc9',
              700: '#0355a3',
              800: '#074885',
              900: '#0c3d6e',
              950: '#08274a'
            },
            aicte: {
              navy: '#07162c',
              midnight: '#050c18',
              slate: '#0f1f38',
              gold: '#d97706',
              amber: '#f59e0b',
              saffron: '#ea580c',
              emerald: '#059669',
              ruby: '#dc2626'
            }
          },
          boxShadow: {
            'glow-amber': '0 0 25px -3px rgba(245, 158, 11, 0.25)',
            'glow-blue': '0 0 25px -3px rgba(14, 135, 235, 0.25)',
            'glow-emerald': '0 0 25px -3px rgba(16, 185, 129, 0.25)',
            'card-elevated': '0 10px 25px -5px rgba(15, 23, 42, 0.05), 0 8px 10px -6px rgba(15, 23, 42, 0.03)'
          }
        }
      }
    }
  </script>
  
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: #f8fafc;
      color: #0f172a;
    }
    
    /* Premium Glassmorphism */
    .glass-card {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(226, 232, 240, 0.85);
      box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    .glass-card:hover {
      box-shadow: 0 8px 30px -4px rgba(15, 23, 42, 0.07);
    }

    .glass-card-dark {
      background: rgba(11, 23, 44, 0.95);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(51, 65, 85, 0.6);
      box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.3);
    }

    /* Gradient Border Pill */
    .gradient-pill {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02));
      border: 1px solid rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(8px);
    }

    /* Sleek Scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Subtle Animated Pulse Rings */
    @keyframes subtlePulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.85; transform: scale(1.02); }
    }
    .animate-subtle {
      animation: subtlePulse 3s infinite ease-in-out;
    }

    /* Bounding Box Styling */
    .bbox-highlight {
      position: absolute;
      border: 2px solid #ef4444;
      background: rgba(239, 68, 68, 0.15);
      border-radius: 4px;
      box-shadow: 0 0 15px rgba(239, 68, 68, 0.4);
      transition: all 0.3s ease;
      cursor: pointer;
    }
    .bbox-highlight:hover {
      background: rgba(239, 68, 68, 0.3);
      box-shadow: 0 0 25px rgba(239, 68, 68, 0.7);
    }
    .bbox-tag {
      position: absolute;
      top: -22px;
      left: -2px;
      background: #ef4444;
      color: #ffffff;
      font-size: 10px;
      font-weight: 700;
      font-family: 'JetBrains Mono', monospace;
      padding: 1px 6px;
      border-radius: 3px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
      white-space: nowrap;
    }

    /* Custom Toast Container */
    #toast-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: 10px;
      pointer-events: none;
    }
    .toast-msg {
      pointer-events: auto;
      transform: translateY(100%);
      opacity: 0;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .toast-msg.show {
      transform: translateY(0);
      opacity: 1;
    }
  </style>
</head>
<body class="text-slate-800 antialiased flex flex-col min-h-screen bg-slate-50 selection:bg-brand-500 selection:text-white">

  <!-- ============================================================== -->
  <!-- 1. MANDATORY STATUTORY ADVISORY BANNER (AICTE COMPLIANCE)     -->
  <!-- ============================================================== -->
  <div class="bg-gradient-to-r from-aicte-midnight via-aicte-navy to-slate-900 border-b border-amber-500/30 text-white text-xs font-medium py-2 px-4 shadow-sm relative z-50">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
        </span>
        <span class="text-amber-400 font-semibold tracking-wide uppercase text-[11px] font-display">Statutory Mandate:</span>
        <span class="text-slate-200 text-[11px]">
          AICTE Decision-Support System only. Strictly assistive — all final regulatory actions require competent officer scrutiny.
        </span>
      </div>
      <div class="hidden md:flex items-center gap-3 text-[11px] text-slate-400 font-mono">
        <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> OFFLINE-READY</span>
        <span>|</span>
        <span class="text-amber-300">APH 2024–27 COMPLIANT</span>
      </div>
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- 2. HIGH-TECH AICTE BRANDED NAVIGATION BAR                      -->
  <!-- ============================================================== -->
  <header class="bg-gradient-to-r from-aicte-midnight via-[#09152a] to-aicte-midnight text-white border-b border-slate-800 sticky top-0 z-40 backdrop-blur-xl bg-opacity-95 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 py-2.5 flex items-center justify-between">
      
      <!-- Logo & Emblem Section -->
      <div class="flex items-center gap-3.5 cursor-pointer group" onclick="navigate('dashboard')">
        <div class="relative">
          <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-500 via-amber-600 to-orange-600 p-0.5 shadow-glow-amber flex items-center justify-center transition-transform group-hover:scale-105">
            <div class="w-full h-full bg-aicte-midnight rounded-[10px] flex items-center justify-center">
              <svg class="w-6 h-6 text-amber-400" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
            </div>
          </div>
          <span class="absolute -bottom-1 -right-1 bg-blue-600 text-[9px] font-bold px-1 rounded border border-blue-400 text-white font-mono">AI</span>
        </div>
        
        <div>
          <div class="flex items-center gap-2">
            <span class="font-display font-extrabold text-lg tracking-tight text-white group-hover:text-amber-400 transition-colors">AICTE SmartVerify AI</span>
            <span class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow-sm">SIH 2026</span>
          </div>
          <p class="text-[11px] text-slate-300 font-sans tracking-wide">Bureau of Approval • Decision-Support Scrutiny Subsystem</p>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="hidden lg:flex items-center gap-1 bg-slate-900/60 p-1 rounded-xl border border-slate-800/80 text-xs font-medium">
        <button id="nav-dashboard" onclick="navigate('dashboard')" class="px-3.5 py-1.5 rounded-lg text-white bg-slate-800 shadow-sm font-semibold transition-all">Scrutiny Queue</button>
        <button id="nav-detail" onclick="openHeroDetail()" class="px-3.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all">Application Dossier</button>
        <button id="nav-graph" onclick="navigate('graph')" class="px-3.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all">Claim Graph</button>
        <button id="nav-docviewer" onclick="navigate('docviewer')" class="px-3.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all">Evidence BBoxes</button>
        <button id="nav-rag" onclick="navigate('rag')" class="px-3.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all">RAG Handbook</button>
        <button id="nav-applicant" onclick="navigate('applicant')" class="px-3.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all">Applicant Portal</button>
        <button id="nav-admin" onclick="navigate('admin')" class="px-3.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all">Admin Studio</button>
        <button id="nav-audit" onclick="navigate('audit')" class="px-3.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all">Audit Ledger</button>
        <button id="nav-eval" onclick="navigate('eval')" class="px-3.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all">Evaluation</button>
      </nav>

      <!-- Right Controls: Role Switcher & Live Alerts -->
      <div class="flex items-center gap-3">
        
        <!-- Live Alerts Bell -->
        <button onclick="toggleAlertsModal()" class="relative p-2 text-slate-300 hover:text-amber-400 hover:bg-slate-800/80 rounded-xl transition-all border border-transparent hover:border-slate-700">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
          <span id="alert-count-badge" class="absolute top-1.5 right-1.5 w-2.5 h-2.5 bg-red-500 rounded-full animate-ping"></span>
          <span class="absolute top-1.5 right-1.5 w-2.5 h-2.5 bg-red-500 rounded-full"></span>
        </button>

        <!-- Persona Role Switcher -->
        <div class="flex items-center gap-2 bg-gradient-to-r from-slate-900 to-slate-800 px-3 py-1.5 rounded-xl border border-slate-700/80 shadow-inner">
          <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
          <span class="text-[11px] text-slate-400 font-medium">Role:</span>
          <select id="role-select" onchange="handleRoleSwitch(this.value)" class="bg-transparent text-xs font-semibold text-amber-400 focus:outline-none cursor-pointer">
            <option value="officer_sharma" class="bg-slate-900 text-white font-sans">Scrutiny Officer (Dr. Sharma)</option>
            <option value="applicant_sit" class="bg-slate-900 text-white font-sans">Applicant (Dr. Verma - SIT)</option>
            <option value="admin_aicte" class="bg-slate-900 text-white font-sans">Admin (Director Approval)</option>
            <option value="auditor_cag" class="bg-slate-900 text-white font-sans">Auditor (Vigilance / CAG)</option>
          </select>
        </div>
      </div>
    </div>
  </header>

  <!-- ============================================================== -->
  <!-- 3. MAIN APPLICATION VIEWPORT                                   -->
  <!-- ============================================================== -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- ------------------------------------------------------------ -->
    <!-- VIEW 1: OFFICER DASHBOARD & PRIORITY SCRUTINY QUEUE          -->
    <!-- ------------------------------------------------------------ -->
    <section id="view-dashboard" class="space-y-6">
      
      <!-- Top Overview Bar -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2 border-b border-slate-200">
        <div>
          <div class="flex items-center gap-2.5">
            <h1 class="text-2xl font-display font-extrabold text-slate-900 tracking-tight">Institutional Scrutiny Queue</h1>
            <span class="bg-blue-50 text-blue-700 text-xs font-bold px-2.5 py-0.5 rounded-full border border-blue-200">AY 2026–27</span>
          </div>
          <p class="text-xs text-slate-500 mt-1">
            Deterministic risk prioritization engine: <code class="font-mono text-slate-700 bg-slate-100 px-1.5 py-0.5 rounded">min(100, 35×Crit + 15×Maj + 5×Min + 10×Unresolved)</code>
          </p>
        </div>
        
        <div class="flex items-center gap-2.5">
          <button onclick="openUploadModal()" class="px-3.5 py-2 text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow-glow-blue flex items-center gap-2 transition-all">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
            <span>Upload Document</span>
          </button>
          <button onclick="refreshData()" class="px-3.5 py-2 text-xs font-semibold bg-white border border-slate-300 hover:border-slate-400 rounded-xl shadow-sm hover:bg-slate-50 flex items-center gap-2 text-slate-700 transition-all">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            Refresh Data
          </button>
          <button onclick="openHeroDetail()" class="px-4 py-2 text-xs font-bold bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white rounded-xl shadow-glow-amber flex items-center gap-2 transition-all">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            <span>Inspect Priority Case</span>
          </button>
        </div>
      </div>

      <!-- KPI METRIC CARDS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Total Applications -->
        <div class="glass-card p-5 rounded-2xl border-slate-200/80 relative overflow-hidden group">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider font-display">Applications</span>
            <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <p id="kpi-total" class="text-3xl font-display font-extrabold text-slate-900">40</p>
            <span class="text-xs font-medium text-slate-500">active dossiers</span>
          </div>
          <div class="mt-2 text-[11px] text-slate-400 flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span> 100% evaluated offline
          </div>
        </div>

        <!-- Inspection Recommended -->
        <div class="glass-card p-5 rounded-2xl border-slate-200/80 border-l-4 border-l-rose-500 relative overflow-hidden group">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider font-display">Inspection Priority</span>
            <div class="w-9 h-9 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold text-sm">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <p id="kpi-inspection" class="text-3xl font-display font-extrabold text-rose-600">--</p>
            <span class="text-xs font-medium text-rose-700 bg-rose-50 px-1.5 py-0.5 rounded font-mono">Critical</span>
          </div>
          <div class="mt-2 text-[11px] text-slate-500">Severe discrepancies / alterations flagged</div>
        </div>

        <!-- Awaiting Rectification -->
        <div class="glass-card p-5 rounded-2xl border-slate-200/80 border-l-4 border-l-amber-500 relative overflow-hidden group">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider font-display">Rectification</span>
            <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-sm">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <p id="kpi-rectification" class="text-3xl font-display font-extrabold text-amber-600">--</p>
            <span class="text-xs font-medium text-amber-700 bg-amber-50 px-1.5 py-0.5 rounded font-mono">Major Gaps</span>
          </div>
          <div class="mt-2 text-[11px] text-slate-500">Notices sent to applicant institution</div>
        </div>

        <!-- Ready for Official Scrutiny -->
        <div class="glass-card p-5 rounded-2xl border-slate-200/80 border-l-4 border-l-emerald-500 relative overflow-hidden group">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider font-display">Scrutiny Ready</span>
            <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-sm">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <p id="kpi-ready" class="text-3xl font-display font-extrabold text-emerald-600">--</p>
            <span class="text-xs font-medium text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded font-mono">Compliant</span>
          </div>
          <div class="mt-2 text-[11px] text-slate-500">Clean checks with verified provenance</div>
        </div>
      </div>

      <!-- RISK DISTRIBUTION BARS & QUICK FILTER -->
      <div class="glass-card p-4 rounded-2xl border-slate-200/80 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="text-xs font-bold text-slate-600 uppercase tracking-wider font-display">Priority Distribution:</span>
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="px-2.5 py-1 rounded-lg bg-rose-50 text-rose-800 border border-rose-200 font-semibold" id="dist-high">High (≥70): --</span>
            <span class="px-2.5 py-1 rounded-lg bg-amber-50 text-amber-800 border border-amber-200 font-semibold" id="dist-medium">Medium (40-69): --</span>
            <span class="px-2.5 py-1 rounded-lg bg-blue-50 text-blue-800 border border-blue-200 font-semibold" id="dist-low">Low (10-39): --</span>
            <span class="px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 font-semibold" id="dist-minimal">Minimal (<10): --</span>
          </div>
        </div>
        
        <div class="flex items-center gap-2.5">
          <div class="relative">
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input type="text" id="queue-search" oninput="filterQueue()" placeholder="Search Institute or App ID..." class="pl-9 pr-3 py-1.5 text-xs border border-slate-300 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 w-56 shadow-sm">
          </div>
          <select id="queue-category-filter" onchange="filterQueue()" class="px-3 py-1.5 text-xs border border-slate-300 rounded-xl bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
            <option value="">All Categories</option>
            <option value="EoA-Continuation">EoA-Continuation</option>
            <option value="New-Programme">New-Programme</option>
            <option value="Intake-Change">Intake-Change</option>
          </select>
        </div>
      </div>

      <!-- PRIORITY QUEUE TABLE -->
      <div class="glass-card rounded-2xl border-slate-200/80 overflow-hidden shadow-card-elevated">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200 text-left text-xs">
            <thead class="bg-slate-100/80 text-slate-600 uppercase font-display font-semibold tracking-wider">
              <tr>
                <th class="px-5 py-3.5">Application ID</th>
                <th class="px-5 py-3.5">Institution Profile</th>
                <th class="px-5 py-3.5">Category</th>
                <th class="px-5 py-3.5">Declared Intake</th>
                <th class="px-5 py-3.5 text-center">Priority Score</th>
                <th class="px-5 py-3.5">Recommended Outcome</th>
                <th class="px-5 py-3.5 text-center">Findings</th>
                <th class="px-5 py-3.5 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="queue-tbody" class="divide-y divide-slate-100 bg-white">
              <tr><td colspan="8" class="text-center py-10 text-slate-400">Loading priority queue...</td></tr>
            </tbody>
          </table>
        </div>
      </div>


      <!-- SCIENTIFIC & STATUTORY RESEARCH CITATIONS BASELINE -->
      <div class="p-6 rounded-2xl bg-[#dcfce7]/80 border-2 border-[#86efac] text-slate-900 space-y-4 shadow-sm">
        <div class="flex flex-wrap items-center justify-between pb-2 border-b border-emerald-300/80 gap-2">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-600 animate-pulse"></span>
            <h3 class="text-sm font-display font-extrabold text-emerald-950 uppercase tracking-wide">Statutory & Academic Research References</h3>
          </div>
          <span class="text-[11px] font-mono font-bold text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded-full border border-emerald-300">Peer-Reviewed & Statutory Baselines</span>
        </div>

        <div class="space-y-3 text-xs">
          <!-- Citation 1: AICTE APH -->
          <div class="p-3.5 bg-white/90 rounded-xl border border-emerald-200 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <p class="text-slate-900 leading-snug">
                <strong class="font-bold">AICTE Approval Process Handbook (2024–27).</strong>
                Statutory norms for intake, land, and faculty quotas.
                <span class="italic text-slate-600">Ministry of Education, GoI.</span>
              </p>
            </div>
            <a href="https://www.aicte-india.org/sites/default/files/approval/APH%202024-27.pdf" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-lg text-xs shadow-sm transition whitespace-nowrap self-start sm:self-auto">
              <span>Click here</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>

          <!-- Citation 2: Krawetz ELA -->
          <div class="p-3.5 bg-white/90 rounded-xl border border-emerald-200 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <p class="text-slate-900 leading-snug">
                <strong class="font-bold">Digital Document Forensics (Krawetz, IEEE).</strong>
                Error Level Analysis (ELA) and perceptual hashing (pHash) for image tampering detection.
              </p>
            </div>
            <a href="https://www.hackerfactor.com/papers/bh-usa-07-krawetz-wp.pdf" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-lg text-xs shadow-sm transition whitespace-nowrap self-start sm:self-auto">
              <span>Click here</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>

          <!-- Citation 3: Knowledge Graphs -->
          <div class="p-3.5 bg-white/90 rounded-xl border border-emerald-200 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <p class="text-slate-900 leading-snug">
                <strong class="font-bold">Regulatory Knowledge Graphs (Agal et al., 2025).</strong>
                Entity-relation graph mapping applied to AICTE claims vs. verified baselines.
              </p>
            </div>
            <a href="https://arxiv.org/abs/2102.10006" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-lg text-xs shadow-sm transition whitespace-nowrap self-start sm:self-auto">
              <span>Click here</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- THREE STATUTORY PILLARS WITH CLICK HERE BUTTONS -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="glass-card p-4 rounded-xl border border-blue-200 bg-blue-50/30 flex flex-col justify-between space-y-3">
          <div>
            <div class="flex items-center justify-between">
              <span class="font-display font-bold text-blue-900 text-sm">DigiLocker & API Setu</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-800">Verification</span>
            </div>
            <p class="text-slate-600 mt-2">Verifies certificates via Ed25519 digital signatures and QR codes.</p>
          </div>
          <a href="https://www.digilocker.gov.in" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg text-xs shadow-xs transition">
            <span>Click Here</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>

        <div class="glass-card p-4 rounded-xl border border-amber-200 bg-amber-50/30 flex flex-col justify-between space-y-3">
          <div>
            <div class="flex items-center justify-between">
              <span class="font-display font-bold text-amber-900 text-sm">AICTE APH Norms</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">Deterministic</span>
            </div>
            <p class="text-slate-600 mt-2">Encodes statutory clauses as deterministic YAML rules.</p>
          </div>
          <a href="https://www.aicte-india.org" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-lg text-xs shadow-xs transition">
            <span>Click Here</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>

        <div class="glass-card p-4 rounded-xl border border-indigo-200 bg-indigo-50/30 flex flex-col justify-between space-y-3">
          <div>
            <div class="flex items-center justify-between">
              <span class="font-display font-bold text-indigo-900 text-sm">DPDP Act 2023</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-100 text-indigo-800">Privacy</span>
            </div>
            <p class="text-slate-600 mt-2">Applies automated PII masking (Aadhaar/PAN) for privacy.</p>
          </div>
          <a href="https://www.meity.gov.in/content/digital-personal-data-protection-act-2023" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-lg text-xs shadow-xs transition">
            <span>Click Here</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------ -->
    <!-- VIEW 2: APPLICATION DOSSIER & DETAILED SCRUTINY              -->
    <!-- ------------------------------------------------------------ -->
    <section id="view-detail" class="space-y-6 hidden">
      
      <!-- Dossier Header Card -->
      <div class="glass-card p-6 rounded-2xl border-slate-200/80 flex flex-col md:flex-row md:items-center justify-between gap-5 relative overflow-hidden">
        <div class="space-y-2">
          <div class="flex flex-wrap items-center gap-3">
            <div id="detail-inst-avatar" class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-600 to-indigo-700 text-white flex items-center justify-center font-display font-extrabold text-base shadow-md">
              AIT
            </div>
            <div>
              <div class="flex items-center gap-2.5">
                <h1 id="detail-inst-name" class="text-2xl font-display font-bold text-slate-900">Apex Institute of Technology</h1>
                <span id="detail-hero-badge" class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-300">ACTIVE DOSSIER</span>
              </div>
              <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 mt-0.5">
                <span>App ID: <strong id="detail-app-id" class="font-mono text-slate-800">APP-2026-SIT01</strong></span>
                <span>•</span>
                <span>Institute ID: <strong id="detail-inst-id" class="font-mono text-slate-800">AICTE-SIT-001</strong></span>
                <span>•</span>
                <span>Category: <strong id="detail-category" class="text-slate-800">EoA-Continuation</strong></span>
                <span>•</span>
                <span>Intake: <strong id="detail-declared-intake" class="text-slate-800">120 seats</strong></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Scrutiny Officer Action Bar -->
        <div class="flex flex-wrap items-center gap-2.5">
          <button onclick="openUploadModal(currentAppDetail ? currentAppDetail.application.id : 'APP-2026-SIT01')" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-sm flex items-center gap-1.5 transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
            Upload Document
          </button>
          <button onclick="promptOfficerAction('refer_for_inspection')" class="px-4 py-2.5 bg-gradient-to-r from-rose-600 to-rose-700 hover:from-rose-700 hover:to-rose-800 text-white text-xs font-bold rounded-xl shadow-sm flex items-center gap-1.5 transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            Refer for Physical EVC
          </button>
          <button onclick="promptOfficerAction('request_rectification')" class="px-4 py-2.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white text-xs font-bold rounded-xl shadow-sm flex items-center gap-1.5 transition-all">
            Request Rectification
          </button>
          <button onclick="promptOfficerAction('mark_ready_for_scrutiny')" class="px-4 py-2.5 bg-slate-800 hover:bg-slate-900 text-white text-xs font-bold rounded-xl shadow-sm flex items-center gap-1.5 transition-all">
            Scrutiny Complete
          </button>
        </div>
      </div>

      <!-- Transparent Risk Scoring Banner -->
      <div class="rounded-2xl p-6 bg-gradient-to-r from-aicte-midnight via-slate-900 to-[#0e213d] text-white border border-slate-800 shadow-xl relative overflow-hidden">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          <div class="space-y-2">
            <div class="flex items-center gap-3">
              <span class="text-xs uppercase tracking-wider text-amber-400 font-display font-extrabold">Deterministic Priority Formula</span>
              <span id="detail-risk-band" class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">MEDIUM PRIORITY</span>
            </div>
            <div class="text-sm font-mono text-slate-200">
              Score = min(100, 35×Crit[<span id="score-crit" class="text-rose-400 font-bold">1</span>] + 15×Maj[<span id="score-maj" class="text-amber-400 font-bold">2</span>] + 5×Min[0] + 10×Unres[<span id="score-unres" class="text-blue-400 font-bold">0</span>]) = <strong id="score-total" class="text-amber-400 text-2xl font-display font-black">65.0</strong><span class="text-slate-400 text-xs">/100</span>
            </div>
            <p class="text-[11px] text-slate-400 max-w-2xl leading-relaxed">
              Transparent, fully explainable metric used solely to rank scrutiny queues. Does not automate final approval or rejection.
            </p>
          </div>
          
          <div class="flex flex-wrap items-center gap-3">
            <button onclick="navigate('graph')" class="px-4 py-2.5 bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold rounded-xl shadow-glow-blue flex items-center gap-2 transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/></svg>
              Inspect Conflict Graph
            </button>
            <button onclick="navigate('docviewer')" class="px-4 py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold rounded-xl shadow-glow-amber flex items-center gap-2 transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              View Document BBoxes
            </button>
          </div>
        </div>
      </div>

      <!-- MAIN SPLIT: CHECKLIST & FORENSIC PANELS -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Left 2 Cols: Deterministic Checklist & Issuer Adapters -->
        <div class="lg:col-span-2 space-y-6">
          
          <!-- Deterministic Checklist -->
          <div class="glass-card rounded-2xl border-slate-200/80 p-6 shadow-sm">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
              <div>
                <h2 class="text-base font-display font-bold text-slate-900">Deterministic Regulatory Checklist</h2>
                <p class="text-xs text-slate-500">Every check is governed by strict deterministic rules with citations to official AICTE APH clauses</p>
              </div>
              <span class="text-[11px] font-mono text-brand-700 bg-brand-50 px-2 py-0.5 rounded border border-brand-200">10 Active Checks</span>
            </div>
            
            <div id="checklist-container" class="mt-4 space-y-3.5">
              <!-- Rendered via JS -->
            </div>
          </div>

          <!-- Issuer Verification Panel -->
          <div class="glass-card rounded-2xl border-slate-200/80 p-6 shadow-sm">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
              <div>
                <h3 class="text-base font-display font-bold text-slate-900">Authoritative Issuer Verifications</h3>
                <p class="text-xs text-slate-500">Simulated external adapter checks: DigiLocker, Ed25519 QR, and University NOC APIs</p>
              </div>
              <button onclick="triggerIssuerVerification()" class="px-3 py-1.5 text-xs font-bold bg-brand-50 hover:bg-brand-100 text-brand-700 border border-brand-200 rounded-xl transition-all">
                Run Live Adapters
              </button>
            </div>
            
            <div id="issuer-verif-container" class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3">
              <!-- Rendered via JS -->
            </div>
          </div>
        </div>

        <!-- Right 1 Col: Infrastructure Evidence & Quick RAG -->
        <div class="space-y-6">
          
          <!-- Infrastructure Photo Triage -->
          <div class="glass-card rounded-2xl border-slate-200/80 p-5 shadow-sm">
            <div class="pb-2 border-b border-slate-100">
              <h3 class="text-sm font-display font-bold text-slate-900">Infrastructure Photographic Triage</h3>
              <p class="text-[11px] text-slate-500">Computer vision clarity (Laplacian blur variance) and duplicate detection</p>
            </div>
            
            <div id="infra-photos-gallery" class="grid grid-cols-2 gap-2.5 mt-3">
              <!-- Rendered via JS -->
            </div>

            <div id="infra-triage-summary" class="mt-3.5 p-3 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-700">
              <!-- Summary -->
            </div>
          </div>

          <!-- Fast RAG Query Assistant -->
          <div class="glass-card rounded-2xl border-slate-200/80 p-5 shadow-sm bg-gradient-to-br from-white via-blue-50/20 to-amber-50/20">
            <div class="pb-2 border-b border-slate-100">
              <h3 class="text-sm font-display font-bold text-slate-900 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-brand-500"></span>
                Quick Handbook Query
              </h3>
              <p class="text-[11px] text-slate-500">Ask questions regarding applicable AICTE APH clauses</p>
            </div>
            
            <div class="space-y-2 mt-3">
              <input type="text" id="quick-rag-input" placeholder="e.g. What is the clause for intake mismatch?" class="w-full text-xs px-3.5 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 shadow-sm">
              <button onclick="askQuickRAG()" class="w-full py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold rounded-xl transition-all shadow-sm">
                Retrieve Statutory Norms
              </button>
            </div>

            <div id="quick-rag-output" class="mt-3 p-3 bg-white rounded-xl border border-slate-200 text-xs text-slate-700 hidden max-h-48 overflow-y-auto shadow-sm">
              <!-- RAG output -->
            </div>
          </div>

        </div>
      </div>


      <!-- SCIENTIFIC & STATUTORY RESEARCH CITATIONS BASELINE -->
      <div class="p-6 rounded-2xl bg-[#dcfce7]/80 border-2 border-[#86efac] text-slate-900 space-y-4 shadow-sm">
        <div class="flex flex-wrap items-center justify-between pb-2 border-b border-emerald-300/80 gap-2">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-600 animate-pulse"></span>
            <h3 class="text-sm font-display font-extrabold text-emerald-950 uppercase tracking-wide">Statutory & Academic Research References</h3>
          </div>
          <span class="text-[11px] font-mono font-bold text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded-full border border-emerald-300">Peer-Reviewed & Statutory Baselines</span>
        </div>

        <div class="space-y-3 text-xs">
          <!-- Citation 1: AICTE APH -->
