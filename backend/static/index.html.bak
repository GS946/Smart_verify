        <div class="glass-card p-4 rounded-xl border border-indigo-200 bg-indigo-50/30 flex flex-col justify-between space-y-3">
          <div>
            <div class="flex items-center justify-between">
              <span class="font-display font-bold text-indigo-900 text-sm">DPDP Act 2023</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-100 text-indigo-800">Privacy</span>
            </div>
            <p class="text-slate-600 mt-2">Applies automated PII masking (Aadhaar/PAN) for privacy.</p>
          </div>
          <a href="https://www.meity.gov.in/content/digital-personal-data-protection-act-2023" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-lg text-xs shadow-xs transition">
            <span>Click Here</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>
    </section>

  </main>

  <!-- ============================================================== -->
  <!-- 4. MODALS & SLIDE-OVERS                                        -->
  <!-- ============================================================== -->

  <!-- NOTIFICATIONS MODAL -->
  <div id="alerts-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-xl w-full p-6 shadow-2xl border border-slate-200 space-y-4 max-h-[85vh] flex flex-col">
      <div class="flex items-center justify-between pb-2 border-b border-slate-200">
        <div>
          <h3 class="text-base font-display font-bold text-slate-900">Regulatory Alert Center</h3>
          <p class="text-xs text-slate-500">Automated regulatory alerts & simulated email dispatches</p>
        </div>
        <button onclick="toggleAlertsModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center font-bold">✕</button>
      </div>

      <div id="alerts-list" class="flex-1 overflow-y-auto space-y-2.5 text-xs pr-1">
        <!-- Rendered via JS -->
      </div>
    </div>
  </div>

  <!-- OFFICER ACTION CONFIRMATION MODAL -->
  <div id="action-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-slate-200">
        <div>
          <h3 id="modal-action-title" class="text-base font-display font-bold text-slate-900">Record Officer Action</h3>
          <p class="text-xs text-slate-500">Human-in-the-loop statutory audit requirement</p>
        </div>
        <button onclick="closeActionModal()" class="w-7 h-7 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center font-bold">✕</button>
      </div>

      <div class="space-y-3 text-xs">
        <label class="block font-semibold text-slate-700">Scrutiny Officer Remarks & Rationale:</label>
        <textarea id="modal-action-notes" rows="4" class="w-full text-xs p-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-500 bg-slate-50"></textarea>
      </div>

      <div class="flex items-center justify-end gap-2.5 pt-2">
        <button onclick="closeActionModal()" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl">Cancel</button>
        <button id="modal-action-submit-btn" onclick="submitOfficerAction()" class="px-5 py-2 text-xs font-bold bg-slate-900 hover:bg-slate-800 text-white rounded-xl shadow">Confirm & Record</button>
      </div>
    </div>
  </div>

  <!-- SECURE DOCUMENT UPLOAD & VERIFY MODAL -->
  <div id="upload-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-xl w-full p-6 shadow-2xl border border-slate-200 space-y-5 animate-in fade-in duration-200 max-h-[92vh] overflow-y-auto">
      
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          </div>
          <div>
            <h3 class="text-base font-display font-bold text-slate-900">Upload & Verify Statutory Document</h3>
            <p class="text-xs text-slate-500">AES-128 Fernet encryption, automated OCR extraction, and instant rule re-evaluation</p>
          </div>
        </div>
        <button onclick="closeUploadModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition">✕</button>
      </div>

      <!-- Quick Test Samples Selector -->
      <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200/80 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-600">Quick Test Samples</span>
          <span class="text-[10px] text-indigo-600 font-semibold">1-Click Local Load</span>
        </div>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <button type="button" onclick="loadSampleDoc('Sample_Fire_NOC_Valid.pdf', 'NOC-Fire')" class="p-2 text-left rounded-xl bg-white border border-slate-200 hover:border-indigo-400 hover:bg-indigo-50/40 transition">
            <div class="font-bold text-emerald-700">✓ Valid Fire NOC</div>
            <div class="text-[10px] text-slate-400">Expires 2027-12-31</div>
          </button>
          <button type="button" onclick="loadSampleDoc('Sample_Fire_NOC_Expired.pdf', 'NOC-Fire')" class="p-2 text-left rounded-xl bg-white border border-slate-200 hover:border-rose-400 hover:bg-rose-50/40 transition">
            <div class="font-bold text-rose-700">✗ Expired Fire NOC</div>
            <div class="text-[10px] text-slate-400">Expired 2023-05-15</div>
          </button>
          <button type="button" onclick="loadSampleDoc('Sample_Affiliation_Order_Valid.pdf', 'NOC-Affiliating University')" class="p-2 text-left rounded-xl bg-white border border-slate-200 hover:border-indigo-400 hover:bg-indigo-50/40 transition">
            <div class="font-bold text-indigo-700">✓ Affiliation Order</div>
            <div class="text-[10px] text-slate-400">Valid 2027-06-30</div>
          </button>
          <button type="button" onclick="loadSampleDoc('Sample_TER_Payment_Receipt.pdf', 'TER payment receipt')" class="p-2 text-left rounded-xl bg-white border border-slate-200 hover:border-indigo-400 hover:bg-indigo-50/40 transition">
            <div class="font-bold text-slate-700">✓ TER Fee Receipt</div>
            <div class="text-[10px] text-slate-400">Reconciled INR 2L</div>
          </button>
        </div>
      </div>

      <!-- Upload Form -->
      <form id="modal-upload-form" onsubmit="handleModalUpload(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Target Application Dossier</label>
          <select id="modal-upload-app-id" required class="w-full text-xs px-3.5 py-2.5 border border-slate-300 rounded-xl bg-white focus:ring-2 focus:ring-indigo-500 font-mono">
            <!-- Populated dynamically -->
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Document Classification</label>
          <select id="modal-upload-doc-type" required class="w-full text-xs px-3.5 py-2.5 border border-slate-300 rounded-xl bg-white focus:ring-2 focus:ring-indigo-500">
            <option value="auto">Auto-Detect from Content (OCR Text Analysis)</option>
            <option value="NOC-Fire">NOC-Fire (Fire Safety Certificate)</option>
            <option value="NOC-Affiliating University">NOC-Affiliating University</option>
            <option value="TER payment receipt">TER payment receipt</option>
            <option value="Building plan">Building plan & Occupancy Certificate</option>
            <option value="Accreditation certificate">Accreditation certificate (NBA / NAAC)</option>
            <option value="Supporting document">Supporting document</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Select File (PDF / Scanned Image - Max 25MB)</label>
          <input type="file" id="modal-upload-file" required accept=".pdf,.png,.jpg,.jpeg" class="w-full text-xs p-2.5 border border-slate-300 rounded-xl bg-white focus:ring-2 focus:ring-indigo-500">
          <p id="modal-selected-filename" class="text-[11px] text-indigo-600 mt-1 font-mono hidden"></p>
        </div>

        <!-- Result / Feedback Banner -->
        <div id="modal-upload-result" class="p-3.5 rounded-xl text-xs hidden border space-y-1"></div>

        <div class="flex items-center justify-end gap-2.5 pt-2">
          <button type="button" onclick="closeUploadModal()" class="px-4 py-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl transition">Cancel</button>
          <button type="submit" id="modal-upload-btn" class="px-5 py-2.5 text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow-glow-blue flex items-center gap-2 transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Ingest & Re-Scrutinize
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- TOAST NOTIFICATION CONTAINER -->
  <div id="toast-container"></div>

  <!-- ============================================================== -->
  <!-- 5. FRONTEND LOGIC & DATA BINDINGS                              -->
  <!-- ============================================================== -->
  <script>
    const API_BASE = window.location.origin + '/api';
    let allApplications = [];
    let currentAppDetail = null;
    let currentDocDetail = null;
    let selectedFindingId = null;
    let currentZoom = 1.0;
    let pendingActionType = null;
    let authTokens = {}; // Role-based JWT tokens

    // Pre-seeded credentials for instant live role demonstration
    const DEMO_CREDENTIALS = {
      officer_sharma: { username: 'officer_sharma', password: 'officer123', role: 'Scrutiny Officer' },
      applicant_sit: { username: 'applicant_sit', password: 'applicant123', role: 'Applicant' },
      admin_aicte: { username: 'admin_aicte', password: 'admin123', role: 'Admin' },
      auditor_cag: { username: 'auditor_cag', password: 'auditor123', role: 'Auditor' }
    };
    let currentUsername = 'officer_sharma';

    // Toast Manager (replaces harsh browser alerts)
    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      
      let bg = 'bg-slate-900 text-white border-slate-700';
      let icon = 'ℹ️';
      if (type === 'success') {
        bg = 'bg-emerald-900 text-emerald-100 border-emerald-700';
        icon = '✅';
      } else if (type === 'error') {
        bg = 'bg-rose-900 text-rose-100 border-rose-700';
        icon = '⚠️';
      } else if (type === 'warning') {
        bg = 'bg-amber-900 text-amber-100 border-amber-700';
        icon = '🔔';
      }

      toast.className = `toast-msg flex items-center gap-2.5 px-4 py-3 rounded-xl border shadow-xl text-xs font-medium max-w-sm ${bg}`;
      toast.innerHTML = `<span>${icon}</span><span class="flex-1">${message}</span>`;
      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.add('show');
      });

      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }

    // Helper for authorized fetch
    async function authFetch(url, options = {}) {
      options.headers = options.headers || {};
      const token = authTokens[currentUsername];
      if (token) {
        options.headers['Authorization'] = `Bearer ${token}`;
      }
      return fetch(url, options);
    }

    async function loginAllDemoUsers() {
      for (const [key, creds] of Object.entries(DEMO_CREDENTIALS)) {
        try {
          const res = await fetch(`${API_BASE}/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: creds.username, password: creds.password })
          });
          if (res.ok) {
            const data = await res.json();
            authTokens[key] = data.access_token;
          }
        } catch (e) {
          console.warn(`Could not pre-login ${key}:`, e);
        }
      }
    }

    async function init() {
      await loginAllDemoUsers();
      await loadApplications();
      await loadAlerts();
      await loadAuditLogs();
      await loadThresholds();
    }

    // Navigation
    async function navigate(viewName) {
      const views = ['dashboard', 'detail', 'docviewer', 'graph', 'rag', 'applicant', 'admin', 'audit', 'eval'];
      views.forEach(v => {
        const el = document.getElementById(`view-${v}`);
        const navBtn = document.getElementById(`nav-${v}`);
        if (el) el.classList.toggle('hidden', v !== viewName);
        if (navBtn) {
          if (v === viewName) {
            navBtn.classList.add('bg-slate-800', 'text-white', 'shadow-sm');
            navBtn.classList.remove('text-slate-300');
          } else {
            navBtn.classList.remove('bg-slate-800', 'text-white', 'shadow-sm');
            navBtn.classList.add('text-slate-300');
          }
        }
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });

      if (viewName === 'docviewer') {
        if (!currentAppDetail) {
          await openDetail('APP-2026-SIT01', false);
        }
        if (currentAppDetail && currentAppDetail.documents.length) {
          const docToLoad = currentDocDetail ? currentDocDetail.id : currentAppDetail.documents[0].id;
          await loadDocInViewer(docToLoad);
        }
      } else if (viewName === 'graph') {
        if (!currentAppDetail) {
          await openDetail('APP-2026-SIT01', false);
        } else {
          drawGraph(currentAppDetail.application.id);
        }
      }
    }

    async function handleRoleSwitch(userKey) {
      currentUsername = userKey;
      const role = DEMO_CREDENTIALS[userKey].role;
      showToast(`Switched active session to: ${DEMO_CREDENTIALS[userKey].role}`, 'info');

      if (role === 'Applicant') {
        navigate('applicant');
        await openDetail('APP-2026-SIT01');
      } else if (role === 'Admin') {
        navigate('admin');
        await loadThresholds();
      } else if (role === 'Auditor') {
        navigate('audit');
        await loadAuditLogs();
      } else {
        navigate('dashboard');
        await loadApplications();
      }
    }

    // Applications & Dashboard
    async function loadApplications() {
      try {
        const res = await authFetch(`${API_BASE}/applications`);
        const data = await res.json();
        allApplications = data.applications || [];
        
        // Update KPIs
        if (data.kpis) {
          document.getElementById('kpi-total').innerText = data.kpis.total_applications || 40;
          document.getElementById('kpi-inspection').innerText = data.kpis.inspection_recommended || 0;
          document.getElementById('kpi-rectification').innerText = data.kpis.awaiting_rectification || 0;
          document.getElementById('kpi-ready').innerText = data.kpis.ready_for_scrutiny || 0;
        }

        // Update Risk Distribution
        if (data.risk_distribution) {
          document.getElementById('dist-high').innerText = `High (≥70): ${data.risk_distribution.High}`;
          document.getElementById('dist-medium').innerText = `Medium (40-69): ${data.risk_distribution.Medium}`;
          document.getElementById('dist-low').innerText = `Low (10-39): ${data.risk_distribution.Low}`;
          document.getElementById('dist-minimal').innerText = `Minimal (<10): ${data.risk_distribution.Minimal}`;
        }

        renderQueueTable(allApplications);
      } catch (err) {
        console.error('Failed to load applications:', err);
      }
    }

    function renderQueueTable(apps) {
      const tbody = document.getElementById('queue-tbody');
      if (!apps.length) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center py-8 text-slate-400">No applications found.</td></tr>';
        return;
      }

      tbody.innerHTML = apps.map(a => {
        let bandBadge = 'bg-slate-100 text-slate-700';
        if (a.risk_band === 'High') bandBadge = 'bg-rose-50 text-rose-700 border border-rose-200';
        else if (a.risk_band === 'Medium') bandBadge = 'bg-amber-50 text-amber-800 border border-amber-200';
        else if (a.risk_band === 'Low') bandBadge = 'bg-sky-50 text-sky-800 border border-sky-200';
        else bandBadge = 'bg-emerald-50 text-emerald-800 border border-emerald-200';

        let statusBadge = 'bg-slate-100 text-slate-700';
        if (a.status.includes('inspection')) statusBadge = 'bg-rose-50 text-rose-700 border border-rose-200 font-semibold';
        else if (a.status.includes('Rectification')) statusBadge = 'bg-amber-50 text-amber-700 border border-amber-200 font-semibold';
        else if (a.status.includes('Ready')) statusBadge = 'bg-emerald-50 text-emerald-700 border border-emerald-200 font-semibold';

        const isHero = a.id === 'APP-2026-SIT01';

        return `
          <tr class="hover:bg-slate-50/80 transition-colors cursor-pointer ${isHero ? 'bg-amber-50/30' : ''}" onclick="openDetail('${a.id}')">
            <td class="px-5 py-3.5 font-mono font-bold text-brand-700 flex items-center gap-1.5">
              ${isHero ? '<span class="text-amber-500">⭐</span>' : ''}
              ${a.id}
            </td>
            <td class="px-5 py-3.5">
              <div class="font-bold text-slate-900">${a.institution_name}</div>
              <div class="text-[10px] text-slate-400 font-mono">${a.institution_id}</div>
            </td>
            <td class="px-5 py-3.5 text-slate-600 font-medium">${a.category}</td>
            <td class="px-5 py-3.5 font-semibold text-slate-800">${a.declared_intake} seats</td>
            <td class="px-5 py-3.5 text-center">
              <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold font-mono ${bandBadge}">
                ${a.risk_score.toFixed(0)} (${a.risk_band})
              </span>
            </td>
            <td class="px-5 py-3.5">
              <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] ${statusBadge}">
                ${a.status}
              </span>
            </td>
            <td class="px-5 py-3.5 text-center">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full font-mono font-bold text-xs ${a.findings_count > 0 ? 'bg-rose-100 text-rose-700' : 'bg-slate-100 text-slate-500'}">
                ${a.findings_count}
              </span>
            </td>
            <td class="px-5 py-3.5 text-right">
              <button onclick="event.stopPropagation(); openDetail('${a.id}')" class="px-3 py-1.5 text-xs bg-slate-900 text-white rounded-xl hover:bg-slate-800 font-bold transition shadow-sm">
                Scrutinize
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    function filterQueue() {
      const q = document.getElementById('queue-search').value.toLowerCase();
      const cat = document.getElementById('queue-category-filter').value;

      const filtered = allApplications.filter(a => {
        const matchesQuery = a.institution_name.toLowerCase().includes(q) || a.id.toLowerCase().includes(q) || a.institution_id.toLowerCase().includes(q);
        const matchesCat = !cat || a.category === cat;
        return matchesQuery && matchesCat;
      });

      renderQueueTable(filtered);
    }

    async function openHeroDetail() {
      const topApp = allApplications.length > 0 ? allApplications[0].id : 'APP-2026-SIT01';
      await openDetail(topApp);
    }

    async function openDetail(appId, switchView = true) {
      try {
        const res = await authFetch(`${API_BASE}/applications/${appId}`);
        const data = await res.json();
        currentAppDetail = data;

        // Set Headers
        document.getElementById('detail-inst-name').innerText = data.application.institution_name;
        document.getElementById('detail-app-id').innerText = data.application.id;
        document.getElementById('detail-inst-id').innerText = data.application.institution_id;
        document.getElementById('detail-category').innerText = data.application.category;
        document.getElementById('detail-declared-intake').innerText = `${data.application.declared_intake} seats`;

        // Risk breakdown
        const rb = data.risk_breakdown;
        document.getElementById('score-crit').innerText = rb.breakdown.critical_findings;
        document.getElementById('score-maj').innerText = rb.breakdown.major_findings;
        document.getElementById('score-unres').innerText = rb.breakdown.unresolved_verifications;
        document.getElementById('score-total').innerText = rb.score.toFixed(1);
        document.getElementById('detail-risk-band').innerText = `${rb.band.toUpperCase()} PRIORITY`;

        // Render Checklist
        renderChecklist(data.checklist);

        // Render Verifications
        renderVerifications(data.verifications);

        // Render Photos
        renderPhotosGallery(data.infrastructure_triage);

        // Populate doc viewer select
        const docSel = document.getElementById('docviewer-select');
        docSel.innerHTML = '<option value="">Select Document to Inspect...</option>' + 
          data.documents.map(d => `<option value="${d.id}">${d.doc_type} (${d.filename})</option>`).join('');

        // Also render applicant notice list
        renderApplicantNotices(data.findings);

        if (switchView) {
          await navigate('detail');
        }
        drawGraph(data.application.id);
      } catch (err) {
        console.error('Failed to load application detail:', err);
        showToast('Failed to load application details', 'error');
      }
    }

    function renderChecklist(checklist) {
      const container = document.getElementById('checklist-container');
      container.innerHTML = checklist.map(item => {
        const isPass = item.status === 'PASS';
        return `
          <div class="p-4 rounded-xl border transition-all ${isPass ? 'bg-emerald-50/30 border-emerald-200' : 'bg-rose-50/40 border-rose-200'}">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold ${isPass ? 'bg-emerald-600 text-white' : 'bg-rose-600 text-white'}">
                  ${isPass ? '✓' : '!'}
                </span>
                <span class="font-display font-bold text-slate-900 text-xs">${item.name}</span>
                <span class="text-[10px] font-mono text-slate-400">(${item.rule_id})</span>
              </div>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold font-mono ${isPass ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">
                ${item.status}
              </span>
            </div>
            <p class="text-xs text-slate-600 mt-1.5 pl-8">${item.description}</p>
            <div class="text-[10px] text-slate-500 pl-8 mt-1 font-mono">Statutory Clause: <strong class="text-brand-700 font-bold">${item.clause_ref}</strong> (v${item.version})</div>

            ${item.findings.length ? `
              <div class="mt-3 pl-8 space-y-2">
                ${item.findings.map(f => `
                  <div class="p-3 rounded-xl bg-white border border-rose-200 text-xs text-rose-900 flex items-start justify-between shadow-sm">
                    <div>
                      <span class="font-bold text-rose-700 font-mono">[${f.severity}]</span> ${f.plain_reason}
                      <div class="text-[10px] text-slate-500 mt-1 font-mono">Declared/Extracted: <strong class="text-rose-700">${f.extracted_value}</strong> | Baseline: <strong>${f.comparison_value}</strong></div>
                    </div>
                    <button onclick="inspectFinding('${f.id}')" class="text-[10px] px-2.5 py-1 bg-rose-100 hover:bg-rose-200 text-rose-800 rounded-lg font-bold transition ml-2">
                      View BBox
                    </button>
                  </div>
                `).join('')}
              </div>
            ` : ''}
          </div>
        `;
      }).join('');
    }

    function renderVerifications(verifs) {
      const container = document.getElementById('issuer-verif-container');
      if (!verifs.length) {
        container.innerHTML = '<p class="text-xs text-slate-400 col-span-2">Click "Run Live Adapters" to query external authority records.</p>';
        return;
      }

      container.innerHTML = verifs.map(v => {
        let badge = 'bg-emerald-100 text-emerald-800';
        if (v.status === 'MISMATCH_DETECTED') badge = 'bg-rose-100 text-rose-800';
        else if (v.status === 'SOURCE_UNAVAILABLE') badge = 'bg-amber-100 text-amber-800';
        else if (v.status === 'PENDING') badge = 'bg-sky-100 text-sky-800';

        return `
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs flex items-center justify-between">
            <div>
              <strong class="text-slate-800 font-display">${v.adapter_name}</strong>
              <div class="text-[10px] font-mono text-slate-400 mt-0.5">${v.reference_no}</div>
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold font-mono ${badge}">
              ${v.status}
            </span>
          </div>
        `;
      }).join('');
    }

    function renderPhotosGallery(infra) {
      const container = document.getElementById('infra-photos-gallery');
      const summary = document.getElementById('infra-triage-summary');

      if (!infra || !infra.inspected_photos.length) {
        container.innerHTML = '<p class="text-xs text-slate-400 col-span-2">No infrastructure photos available.</p>';
        summary.innerHTML = 'Triage status: Pending upload';
        return;
      }

      container.innerHTML = infra.inspected_photos.map(p => `
        <div class="border border-slate-200 rounded-xl p-2 bg-white text-[10px] shadow-sm">
          <div class="h-20 bg-gradient-to-br from-slate-100 to-slate-200 rounded-lg flex items-center justify-center font-display font-bold text-slate-700 uppercase text-center p-2">
            ${p.facility_type}
          </div>
          <p class="font-semibold text-slate-800 truncate mt-1.5">${p.filename}</p>
          <div class="flex justify-between text-slate-500 mt-1 font-mono">
            <span>Blur: ${p.quality.blur_score}</span>
            <span class="${p.quality.is_usable ? 'text-emerald-600' : 'text-rose-600'} font-bold">
              ${p.quality.is_usable ? 'CLEAR' : 'FLAGGED'}
            </span>
          </div>
        </div>
      `).join('');

      summary.innerHTML = `
        <div class="font-bold text-slate-800">Triage Summary: ${infra.overall_recommendation}</div>
        <div class="text-[10px] text-slate-500 mt-1">${infra.statutory_note}</div>
      `;
    }

    function renderApplicantNotices(findings) {
      const container = document.getElementById('applicant-notices-list');
      if (!findings.length) {
        container.innerHTML = '<p class="text-xs text-emerald-600">No active deficiencies on file.</p>';
        return;
      }

      container.innerHTML = findings.map(f => `
        <div class="p-3 bg-rose-50/70 border border-rose-200 rounded-xl text-rose-900">
          <strong class="font-mono text-xs">[${f.severity}] ${f.rule_id}</strong>
          <p class="text-xs mt-1 text-rose-800">${f.plain_reason}</p>
        </div>
      `).join('');
    }

    // Officer Actions & Modal
    function promptOfficerAction(actionType) {
      if (!currentAppDetail) return;
      pendingActionType = actionType;

      const titles = {
        refer_for_inspection: 'Refer for Physical Expert Visit Committee (EVC)',
        request_rectification: 'Request Administrative Rectification Notice',
        mark_ready_for_scrutiny: 'Mark Ready for Formal Scrutiny Committee'
      };
      document.getElementById('modal-action-title').innerText = titles[actionType] || 'Record Scrutiny Action';

      const defaults = {
        refer_for_inspection: 'Physical spot verification recommended due to intake and statutory certificate discrepancy.',
        request_rectification: 'Institution requested to resubmit valid fire safety certificate and reconciliate declared intake seats.',
        mark_ready_for_scrutiny: 'All preliminary verification checklists cleared and verified against central records.'
      };
      document.getElementById('modal-action-notes').value = defaults[actionType] || '';
      document.getElementById('action-modal').classList.remove('hidden');
    }

    function closeActionModal() {
      document.getElementById('action-modal').classList.add('hidden');
      pendingActionType = null;
    }

    async function submitOfficerAction() {
      if (!pendingActionType || !currentAppDetail) return;
      const notes = document.getElementById('modal-action-notes').value;

      try {
        const res = await authFetch(`${API_BASE}/applications/${currentAppDetail.application.id}/action`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: pendingActionType, notes: notes })
        });
        const data = await res.json();
        closeActionModal();
        showToast(data.message || 'Scrutiny action recorded successfully', 'success');
        await openDetail(currentAppDetail.application.id);
        await loadAuditLogs();
        await loadApplications();
      } catch (err) {
        showToast('Action failed: ' + err, 'error');
      }
    }

    async function triggerIssuerVerification() {
      if (!currentAppDetail) return;
      try {
        const res = await authFetch(`${API_BASE}/applications/${currentAppDetail.application.id}/verify-issuer`, { method: 'POST' });
        const data = await res.json();
        showToast(`Queried ${data.verifications.length} external authority adapters`, 'success');
        await openDetail(currentAppDetail.application.id);
      } catch (err) {
        showToast('Verification failed: ' + err, 'error');
      }
    }

    // Document Viewer & Coordinate Bounding Boxes
    async function loadDocInViewer(docId) {
      if (!docId && currentAppDetail && currentAppDetail.documents.length) {
        docId = currentAppDetail.documents[0].id;
      }
      if (!docId) return;

      const doc = currentAppDetail.documents.find(d => d.id === docId);
      if (!doc) return;
      currentDocDetail = doc;

      document.getElementById('pdf-title').innerText = doc.doc_type;

      // Simulated authentic document page layout
      const body = document.getElementById('pdf-body');
      body.innerHTML = `
        <div id="bbox-target-provenance" class="p-3 bg-slate-50 border border-slate-200 rounded-xl font-mono text-[11px] space-y-1 transition-all">
          <p><strong>Document Category:</strong> ${doc.doc_type}</p>
          <p><strong>Artifact Filename:</strong> ${doc.filename}</p>
          <p><strong>SHA-256 Provenance:</strong> <span class="text-brand-700 font-bold">${doc.sha256.substring(0, 32)}...</span></p>
        </div>
        <div class="mt-5 space-y-3 font-sans text-xs">
          <div id="bbox-target-grantee" class="p-2.5 rounded-xl border border-transparent">
            <p><strong>Grantee Institution:</strong> ${currentAppDetail.application.institution_name}</p>
            <p class="mt-0.5"><strong>Permanent AICTE ID:</strong> ${currentAppDetail.application.institution_id}</p>
          </div>
          <div id="bbox-target-date" class="p-2.5 bg-rose-50/70 rounded-xl border border-rose-200 font-mono transition-all">
            <strong>Validity Expiration Date:</strong> <span class="text-rose-600 font-bold">2027-06-30 [Suspected Alteration]</span>
          </div>
          <div id="bbox-target-intake" class="p-2.5 rounded-xl border border-transparent transition-all">
            <p><strong>Approved Intake on Master Record:</strong> 60 seats (Preceding academic session)</p>
            <p class="mt-1"><strong>Declared Intake in Application:</strong> <span class="text-rose-600 font-bold">120 seats (Unapproved 100% expansion)</span></p>
          </div>
        </div>
        <div class="mt-8 pt-4 border-t border-slate-300 text-[10px] text-slate-500 font-mono">
          <p>Digitally signed by Competent Authority under Section 10(k) of the AICTE Act, 1987.</p>
        </div>
      `;

      // Render linked findings in sidebar
      const linked = currentAppDetail.findings.filter(f => f.document_id === doc.id || f.source_document === doc.filename);
      const findingsContainer = document.getElementById('doc-linked-findings');
      if (!linked.length) {
        findingsContainer.innerHTML = '<p class="text-slate-400">No discrepancies flagged for this specific document.</p>';
      } else {
        findingsContainer.innerHTML = linked.map(f => `
          <div onclick="highlightBBox('${f.id}')" class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-900 cursor-pointer hover:bg-rose-100 transition shadow-sm">
            <strong class="font-mono text-xs">${f.rule_id} (${f.severity})</strong>
            <p class="text-[11px] mt-1">${f.plain_reason}</p>
          </div>
        `).join('');
      }

      // Sync dropdown value
      const docSel = document.getElementById('docviewer-select');
      if (docSel) docSel.value = doc.id;

      // Auto highlight first finding if exists (after short DOM paint timeout)
      if (linked.length) {
        setTimeout(() => highlightBBox(linked[0].id), 50);
      } else {
        const layer = document.getElementById('pdf-bbox-layer');
        if (layer) layer.innerHTML = '';
      }
    }

    async function inspectFinding(findingId) {
      if (!currentAppDetail) {
        await openDetail('APP-2026-SIT01', false);
      }
      const finding = currentAppDetail && currentAppDetail.findings
        ? currentAppDetail.findings.find(f => f.id === findingId)
        : null;

      if (finding && finding.document_id) {
        await loadDocInViewer(finding.document_id);
      } else {
        await navigate('docviewer');
      }
      setTimeout(() => highlightBBox(findingId), 100);
    }

    function highlightBBox(findingId) {
      selectedFindingId = findingId;
      const layer = document.getElementById('pdf-bbox-layer');
      const pageEl = document.getElementById('pdf-mock-page');
      if (!layer || !pageEl) return;

      const finding = currentAppDetail && currentAppDetail.findings
        ? currentAppDetail.findings.find(f => f.id === findingId)
        : null;

      // Determine which semantic element to target based on finding rule & reason
      let targetElId = 'bbox-target-provenance';
      let tagLabel = 'EVIDENCE BBOX • CONFIDENCE: 99.4%';

      if (finding) {
        const rule = finding.rule_id || '';
        const reason = (finding.plain_reason || '').toLowerCase();

        if (rule.includes('DUPDOC') || reason.includes('fingerprint') || reason.includes('sha-256') || reason.includes('reuse') || reason.includes('pioneer')) {
          targetElId = 'bbox-target-provenance';
          tagLabel = `${rule} • SHA-256 HASH CONFLICT`;
        } else if (rule.includes('AFFL') || rule.includes('ACCR') || rule.includes('FIRE') || reason.includes('validity') || reason.includes('date') || reason.includes('expir') || reason.includes('alter')) {
          targetElId = 'bbox-target-date';
          tagLabel = `${rule} • ALTERED EXPIRATION DATE`;
        } else if (rule.includes('INTK') || reason.includes('intake') || reason.includes('seats')) {
          targetElId = 'bbox-target-intake';
          tagLabel = `${rule} • UNAPPROVED INTAKE EXPANSION`;
        } else {
          targetElId = 'bbox-target-provenance';
          tagLabel = `${rule} • DISCREPANCY FLAGGED`;
        }
      }

      const targetEl = document.getElementById(targetElId);
      if (!targetEl) return;

      // Calculate exact coordinates relative to mock page container
      const pageRect = pageEl.getBoundingClientRect();
      const targetRect = targetEl.getBoundingClientRect();

      const top = Math.round(targetRect.top - pageRect.top - 4);
      const left = Math.round(targetRect.left - pageRect.left - 4);
      const width = Math.round(targetRect.width + 8);
      const height = Math.round(targetRect.height + 8);

      layer.innerHTML = `
        <div class="bbox-highlight" style="top: ${top}px; left: ${left}px; width: ${width}px; height: ${height}px;">
          <span class="bbox-tag">${tagLabel}</span>
        </div>
      `;

      showToast(`Pinpointed: ${tagLabel}`, 'info');
    }

    function adjustZoom(delta) {
      currentZoom = Math.min(2.0, Math.max(0.6, currentZoom + delta));
      document.getElementById('doc-canvas-container').style.transform = `scale(${currentZoom})`;
      document.getElementById('zoom-level-text').innerText = `${Math.round(currentZoom * 100)}%`;
    }

    function resetZoom() {
      currentZoom = 1.0;
      document.getElementById('doc-canvas-container').style.transform = `scale(1)`;
      document.getElementById('zoom-level-text').innerText = `100%`;
    }

    async function markCurrentFinding(status) {
      if (!selectedFindingId && currentAppDetail && currentAppDetail.findings.length) {
        selectedFindingId = currentAppDetail.findings[0].id;
      }
      if (!selectedFindingId) {
        showToast('Please select a finding from the list first', 'warning');
        return;
      }

      const comment = document.getElementById('finding-comment').value;
      try {
        const res = await authFetch(`${API_BASE}/findings/${selectedFindingId}/review`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: status, comment: comment })
        });
        const data = await res.json();
        showToast(`Finding marked as: ${status}`, 'success');
        await openDetail(currentAppDetail.application.id);
      } catch (err) {
        showToast('Feedback failed: ' + err, 'error');
      }
    }

    // Claim-to-Evidence Canvas Knowledge Graph
    async function drawGraph(appId) {
      const canvas = document.getElementById('graph-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      try {
        const res = await authFetch(`${API_BASE}/applications/${appId}/graph`);
        const data = await res.json();

        // Separate nodes into 3 functional tiers:
        // Tier 1: Authority & Institution (Left, x ≈ 160)
        // Tier 2: Application Claims (Center, x ≈ 520)
        // Tier 3: Statutory Document Evidence (Right, x ≈ 880)
        const leftNodes = [];
        const centerNodes = [];
        const rightNodes = [];

        data.nodes.forEach(n => {
          if (n.type === 'institution' || n.type === 'baseline_record') {
            leftNodes.push(n);
          } else if (n.type === 'document') {
            rightNodes.push(n);
          } else {
            centerNodes.push(n);
          }
        });

        const coords = {};

        // Position Left Nodes
        const leftSpacing = canvas.height / (leftNodes.length + 1);
        leftNodes.forEach((n, i) => {
          coords[n.id] = { x: 160, y: (i + 1) * leftSpacing };
        });

        // Position Center Nodes
        const centerSpacing = canvas.height / (centerNodes.length + 1);
        centerNodes.forEach((n, i) => {
          coords[n.id] = { x: 520, y: (i + 1) * centerSpacing };
        });

        // Position Right Nodes
        const rightSpacing = canvas.height / (rightNodes.length + 1);
        rightNodes.forEach((n, i) => {
          coords[n.id] = { x: 880, y: (i + 1) * rightSpacing };
        });

        // 1. Draw Column Tier Headers
        ctx.font = 'bold 11px "Outfit"';
        ctx.fillStyle = '#64748b';
        ctx.fillText('AUTHORITY & INSTITUTION', 80, 28);
        ctx.fillText('APPLICATION & DECLARED CLAIMS', 430, 28);
        ctx.fillText('SUBMITTED EVIDENCE PROOFS', 790, 28);

        // 2. Draw Smooth Curved Edges
        data.edges.forEach(e => {
          const s = coords[e.source];
          const t = coords[e.target];
          if (!s || !t) return;

          ctx.beginPath();
          ctx.moveTo(s.x, s.y);

          // Smooth curved cubic bezier
          const midX = (s.x + t.x) / 2;
          const cpOffset = Math.abs(t.x - s.x) * 0.4;
          const cp1x = s.x < t.x ? s.x + cpOffset : s.x - cpOffset;
          const cp2x = s.x < t.x ? t.x - cpOffset : t.x + cpOffset;

          ctx.bezierCurveTo(cp1x, s.y, cp2x, t.y, t.x, t.y);

          if (e.is_conflict) {
            ctx.strokeStyle = '#f43f5e';
            ctx.lineWidth = 2.5;
            ctx.setLineDash([6, 5]);
          } else {
            ctx.strokeStyle = 'rgba(56, 189, 248, 0.4)';
            ctx.lineWidth = 1.5;
            ctx.setLineDash([]);
          }
          ctx.stroke();
          ctx.setLineDash([]);

          // Edge Pill Badge at midpoint
          const midY = (s.y + t.y) / 2;
          const labelText = e.label.replace(/_/g, ' ');
          ctx.font = '9px "JetBrains Mono"';
          const textWidth = ctx.measureText(labelText).width;

          ctx.fillStyle = e.is_conflict ? 'rgba(225, 29, 72, 0.9)' : 'rgba(15, 23, 42, 0.85)';
          ctx.strokeStyle = e.is_conflict ? '#f43f5e' : '#334155';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.roundRect(midX - (textWidth / 2) - 6, midY - 9, textWidth + 12, 18, 6);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = e.is_conflict ? '#ffffff' : '#94a3b8';
          ctx.fillText(labelText, midX - (textWidth / 2), midY + 3);
        });

        // 3. Draw Nodes with Clean Pill Cards
        data.nodes.forEach(n => {
          const pos = coords[n.id];
          if (!pos) return;

          const isConflict = n.status === 'conflict';
          const isInst = n.type === 'institution';
          const isBaseline = n.type === 'baseline_record';

          const title = n.label.split('\n')[0];
          const subtitle = n.label.split('\n')[1] || (isConflict ? 'DISCREPANCY FLAGGED' : 'CONSISTENT ON FILE');

          const cardWidth = 190;
          const cardHeight = 44;
          const cardX = pos.x - (cardWidth / 2);
          const cardY = pos.y - (cardHeight / 2);

          // Card Background
          ctx.fillStyle = isConflict ? 'rgba(30, 10, 18, 0.92)' : 'rgba(11, 23, 44, 0.92)';
          ctx.strokeStyle = isConflict ? '#f43f5e' : isInst ? '#f59e0b' : isBaseline ? '#38bdf8' : '#334155';
          ctx.lineWidth = isConflict ? 2 : 1.5;

          ctx.beginPath();
          ctx.roundRect(cardX, cardY, cardWidth, cardHeight, 10);
          ctx.fill();
          ctx.stroke();

          // Status Indicator Dot
          ctx.beginPath();
          ctx.arc(cardX + 16, pos.y, 6, 0, 2 * Math.PI);
          ctx.fillStyle = isConflict ? '#f43f5e' : isInst ? '#f59e0b' : '#10b981';
          ctx.fill();

          // Title
          ctx.fillStyle = isConflict ? '#fecdd3' : '#ffffff';
          ctx.font = 'bold 11px "Outfit"';
          const displayTitle = title.length > 22 ? title.substring(0, 20) + '...' : title;
          ctx.fillText(displayTitle, cardX + 30, pos.y - 3);

          // Subtitle / Detail
          ctx.fillStyle = isConflict ? '#f43f5e' : '#94a3b8';
          ctx.font = '9px "JetBrains Mono"';
          const displaySub = subtitle.length > 25 ? subtitle.substring(0, 23) + '...' : subtitle;
          ctx.fillText(displaySub, cardX + 30, pos.y + 11);
        });

      } catch (err) {
        console.error('Graph draw error:', err);
      }
    }

    // RAG Assistant Queries
    function setRAGQuery(text) {
      document.getElementById('rag-main-input').value = text;
      executeRAGQuery();
    }

    async function executeRAGQuery() {
      const input = document.getElementById('rag-main-input');
      const query = input.value.trim();
      if (!query) return;

      const history = document.getElementById('rag-chat-history');
      history.innerHTML += `
        <div class="bg-white p-3.5 rounded-xl border border-slate-200 text-slate-800 text-right shadow-sm">
          <strong class="text-slate-900 font-display">Officer Inquiry:</strong> ${query}
        </div>
      `;
      input.value = '';

      try {
        const res = await authFetch(`${API_BASE}/rag/query`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: query })
        });
        const data = await res.json();

        let citationHTML = '';
        if (data.citations && data.citations.length) {
          citationHTML = data.citations.map(c => `
            <div class="mt-2.5 p-3 bg-brand-50 rounded-xl border border-brand-200 text-xs text-brand-950">
              <strong class="font-mono">${c.clause_id}</strong> • ${c.academic_year} (${c.category})
              <p class="text-[11px] text-slate-600 mt-1">${c.summary}</p>
            </div>
          `).join('');
        }

        history.innerHTML += `
          <div class="bg-slate-100 p-4 rounded-xl border border-slate-200 text-slate-900 space-y-2 shadow-sm">
            <strong class="text-slate-900 font-display flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-brand-500"></span>
              AICTE Statutory Scrutiny Interpretation:
            </strong>
            <p class="leading-relaxed text-xs">${data.answer}</p>
            ${citationHTML}
            <div class="text-[10px] text-slate-400 mt-1 font-mono">${data.disclaimer || ''}</div>
          </div>
        `;
        history.scrollTop = history.scrollHeight;
      } catch (err) {
        history.innerHTML += `<div class="text-rose-600 p-3 bg-rose-50 rounded-xl">RAG query failed: ${err}</div>`;
      }
    }

    async function askQuickRAG() {
      const q = document.getElementById('quick-rag-input').value;
      if (!q) return;
      const res = await authFetch(`${API_BASE}/rag/query`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query: q })
      });
      const data = await res.json();
      const out = document.getElementById('quick-rag-output');
      out.classList.remove('hidden');
      out.innerHTML = `<strong>${data.found ? 'Citation Identified:' : 'Notice:'}</strong><p class="mt-1 leading-relaxed">${data.answer}</p>`;
    }

    // Applicant Upload Handler
    async function handleApplicantUpload(e) {
      e.preventDefault();
      const fileInput = document.getElementById('upload-file-input');
      const docType = document.getElementById('upload-doc-type').value;
      const appSelect = document.getElementById('upload-app-id');
      const appId = appSelect ? appSelect.value : (currentAppDetail ? currentAppDetail.application.id : 'APP-2026-SIT01');
      if (!fileInput.files.length) return;

      const fd = new FormData();
      fd.append('application_id', appId);
      fd.append('doc_type', docType);
      fd.append('file', fileInput.files[0]);

      try {
        const res = await authFetch(`${API_BASE}/documents/upload`, {
          method: 'POST',
          body: fd
        });
        const data = await res.json();
        const box = document.getElementById('upload-result-box');
        box.classList.remove('hidden');
        box.innerText = `Success: ${data.message} (SHA-256: ${data.sha256.substring(0, 16)}...)`;
        showToast('Document encrypted and submitted successfully', 'success');
        await openDetail('APP-2026-SIT01');
      } catch (err) {
        showToast('Upload failed: ' + err, 'error');
      }
    }

    // Audit Trail Ledger
    async function loadAuditLogs() {
      try {
        const res = await authFetch(`${API_BASE}/audit`);
        if (!res.ok) {
          console.warn('Audit fetch returned status:', res.status);
          return;
        }
        const data = await res.json();
        const tbody = document.getElementById('audit-tbody');
        tbody.innerHTML = (data.logs || []).map(l => `
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-5 py-3 text-slate-500 whitespace-nowrap">${l.timestamp.split('T')[1].split('.')[0]}</td>
            <td class="px-5 py-3 font-bold text-slate-800">${l.actor_id} <span class="text-[10px] text-slate-400 font-normal">(${l.actor_role})</span></td>
            <td class="px-5 py-3 text-brand-700 font-semibold">${l.action}</td>
            <td class="px-5 py-3 text-slate-600">${l.target_id}</td>
            <td class="px-5 py-3 text-emerald-700 font-bold">${l.current_hash.substring(0, 14)}...</td>
            <td class="px-5 py-3 text-slate-400">${l.prev_hash.substring(0, 14)}...</td>
          </tr>
        `).join('');
      } catch (err) {
        console.error('Audit fetch error:', err);
      }
    }

    async function verifyAuditChain() {
      try {
        const res = await authFetch(`${API_BASE}/audit/verify`, { method: 'POST' });
        const data = await res.json();
        showToast(`Cryptographic Integrity Status: ${data.status} (${data.records_checked} hash blocks verified)`, 'success');
      } catch (err) {
        showToast('Audit integrity check failed: ' + err, 'error');
      }
    }

    function exportAuditJSON() {
      window.open(`${API_BASE}/audit`);
    }

    // Admin Thresholds
    async function loadThresholds() {
      try {
        const res = await authFetch(`${API_BASE}/admin/thresholds`);
        const data = await res.json();
        const container = document.getElementById('admin-thresholds-container');
        container.innerHTML = data.map(t => `
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
            <div class="flex justify-between items-center">
              <strong class="text-xs text-slate-900 font-mono">${t.detector_name}</strong>
              <span id="val-${t.id}" class="text-xs font-bold text-brand-700 font-mono bg-brand-50 px-2 py-0.5 rounded border border-brand-200">${t.threshold_value}</span>
            </div>
            <p class="text-[11px] text-slate-500">${t.description}</p>
            <input type="range" min="10" max="100" value="${t.threshold_value}" onchange="updateThreshold('${t.id}', this.value)" class="w-full cursor-pointer accent-brand-600">
          </div>
        `).join('');
      } catch (err) {
        console.error('Thresholds error:', err);
      }
    }

    async function updateThreshold(id, val) {
      document.getElementById(`val-${id}`).innerText = val;
      await authFetch(`${API_BASE}/admin/thresholds/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ threshold_value: parseFloat(val) })
      });
      showToast(`Threshold updated to ${val}`, 'info');
    }

    // Alerts
    async function loadAlerts() {
      try {
        const res = await authFetch(`${API_BASE}/alerts`);
        const data = await res.json();
        const list = document.getElementById('alerts-list');
        list.innerHTML = (data.alerts || []).map(a => `
          <div class="p-3.5 rounded-xl border ${a.severity === 'Critical' ? 'bg-rose-50/70 border-rose-200 text-rose-900' : 'bg-slate-50 border-slate-200 text-slate-800'}">
            <div class="flex items-center justify-between">
              <strong class="text-xs font-bold font-mono">[${a.severity.toUpperCase()}] ${a.alert_type}</strong>
              <span class="text-[10px] text-slate-400 font-mono">${a.application_id}</span>
            </div>
            <p class="text-xs mt-1 leading-relaxed">${a.message}</p>
            <div class="text-[10px] text-slate-400 mt-1 font-mono">${a.institution_name}</div>
          </div>
        `).join('');
      } catch (err) {
        console.error('Alerts load error:', err);
      }
    }

    function toggleAlertsModal() {
      document.getElementById('alerts-modal').classList.toggle('hidden');
    }

    async function refreshData() {
      await loadApplications();
      showToast('Institutional priority records refreshed', 'info');
    }

    window.onload = init;
  </script>
</body>
</html>
