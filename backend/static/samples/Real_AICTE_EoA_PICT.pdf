<!-- Final Year Reopening Notice -->
<div id="reopenNoticeModal" style="display:none; position:fixed; z-index:99999; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,0.6);">
    <div style="background:#fff; width:80%; max-width:700px; margin:5% auto; padding:25px; border-radius:8px; position:relative;">
        
        <span onclick="closeReopenNotice();"
              style="position:absolute; right:15px; top:10px; font-size:28px; cursor:pointer;">&times;</span>

        <h3 style="color:#003366; margin-bottom:20px;">
            Reopening of College for Final Year Students (A.Y. 2026–27)
        </h3>

        <p>
            All Final Year Students are hereby informed that the college will reopen
            for the Academic Year 2026–27 on <strong>Monday, 6 July 2026</strong>.
        </p>

        <p>
            Students are required to attend their classes, laboratory sessions,
            project work, and other academic activities as per the timetable
            notified by their respective departments.
        </p>

        <p>
            Attendance will be counted from the first day of commencement of classes.
            Students are therefore instructed to ensure their presence from the
            reopening date.
        </p>

        <br>

        <p style="text-align:right;">
            <strong>Principal</strong><br>
            SCTR's Pune Institute of Computer Technology, Pune
        </p>
    </div>
</div>

<script>
function showReopenNotice() {
    document.getElementById('reopenNoticeModal').style.display = 'block';
}

function closeReopenNotice() {
    document.getElementById('reopenNoticeModal').style.display = 'none';
}

window.onclick = function(event) {
    var modal = document.getElementById('reopenNoticeModal');
    if (event.target == modal) {
        modal.style.display = 'none';
    }
}
</script>


	
