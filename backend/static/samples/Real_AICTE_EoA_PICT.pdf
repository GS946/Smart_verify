  /* ===== FIX TOP TOOLBAR ALIGNMENT ===== */

/* ===== TOP TOOLBAR FIX ===== *//* ============================= */
/* CLEAN TOP TOOLBAR FIX */
/* ============================= */

.rs-toolbar .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.rs-toolbar .col-md-5,
.rs-toolbar .col-md-7 {
    float: none !important;
    width: auto !important;
    max-width: none !important;
}

.rs-toolbar-right {
    text-align: right;
}

.rs-toolbar-right ul {
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
}

.rs-toolbar-right ul li {
    display: inline-block;
    margin-left: 15px;
}

/* ============================= */
/* GOOGLE SEARCH CLEAN FIX */
/* ============================= */

.gcse-search-wrapper {
    max-width: 300px;
}

.gcse-search-wrapper .gsc-control-cse {
    padding: 0 !important;
    border: none !important;
    background: transparent !important;
}

.gsc-branding {
    display: none !important;
}
/* ================================= */
/* 1️⃣ TOP TOOLBAR FIX (SAFE METHOD) */
/* ================================= */

.rs-toolbar .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.rs-toolbar .col-md-5 {
    flex: 0 0 auto;
}

.rs-toolbar .col-md-7 {
    flex: 0 0 auto;
    text-align: right;
}

.rs-toolbar-right ul {
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
}

.rs-toolbar-right ul li {
    display: inline-block;
    margin-left: 15px;
}


/* ================================= */
/* 2️⃣ MAIN MENU FORCE SINGLE LINE */
/* ================================= */

@media (min-width: 992px) {

    .nav-menu {
        white-space: nowrap;
    }

    .nav-menu > li {
        float: left !important;
    }

    .nav-menu > li > a {
        padding: 12px 10px !important;
        font-size: 13px !important;
    }

}

/* ================================= */
/* FORCE MAIN MENU STRICT ONE LINE */
/* ================================= */

@media (min-width: 992px) {

    .menu-area .container {
        max-width: 100% !important;
        width: 100% !important;
    }

    .nav-menu {
        display: flex !important;
        flex-wrap: nowrap !important;
        justify-content: center !important;
        align-items: center !important;
    }

    .nav-menu > li {
        float: none !important;
        margin: 0 4px !important;
    }

    .nav-menu > li > a {
        padding: 8px 6px !important;
        font-size: 14px !important;
        white-space: nowrap !important;
    }

}

/* ================================= */
/* FIX SUBMENU VERTICAL DROPDOWN */
/* ================================= */

@media (min-width: 992px) {

    /* Submenu reset */
    .nav-menu li ul {
        display: block !important;
        position: absolute !important;
        left: 0 !important;
        top: 100% !important;
        flex-direction: column !important;
        min-width: 220px !important;
        background: #fff !important;
        z-index: 9999 !important;
    }

    .nav-menu li ul li {
        display: block !important;
        width: 100% !important;
        margin: 0 !important;
    }

    .nav-menu li ul li a {
        display: block !important;
        padding: 8px 12px !important;
        white-space: normal !important;
    }

}

