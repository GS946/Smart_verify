}

</style>



<!-- logo code -->

  <!DOCTYPE html>
<html>
<head>
    <style>
        /* Animation Styles */
        @keyframes fullRotation {
            0% {
                transform: scale(0) rotateY(0deg);
                opacity: 0;
                box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.8);
            }
            30% {
                transform: scale(0.7) rotateY(180deg);
                opacity: 0.8;
            }
            60% {
                transform: scale(0.9) rotateY(360deg);
                box-shadow: 0 0 30px 15px rgba(255, 255, 255, 0.6);
            }
            100% {
                transform: scale(1) rotateY(720deg);
                opacity: 1;
                box-shadow: 0 0 10px 5px rgba(255, 255, 255, 0.3);
            }
        }

        @keyframes continuousGlow {
            0%, 100% {
                box-shadow: 0 0 10px 5px rgba(255, 255, 255, 0.3);
            }
            50% {
                box-shadow: 0 0 20px 10px rgba(255, 255, 255, 0.6);
            }
        }

        @keyframes pulseRotation {
            0%, 100% {
                transform: rotateY(0deg);
            }
            50% {
                transform: rotateY(10deg);
            }
        }

        .loader-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.9);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            perspective: 1000px;
        }

        .circle-loader {
            width: 800px;
            height: 8400px;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            transform-style: preserve-3d;
        }

        .logo-circle {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            overflow: hidden;
            position: relative;
            animation: 
                fullRotation 2.5s cubic-bezier(0.25, 0.1, 0.25, 1) forwards,
                pulseRotation 3s ease-in-out infinite 2.5s;
        }

        .logo-circle img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            animation: continuousGlow 2s infinite ease-in-out;
            backface-visibility: visible;
        }

        .radial-waves {
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            pointer-events: none;
        }

        .wave {
            position: absolute;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.1);
            animation: waveExpand 2s linear infinite;
            transform: scale(0);
            opacity: 0;
        }

        @keyframes waveExpand {
            0% {
                transform: scale(0);
                opacity: 0.8;
                border-width: 1px;
            }
            100% {
                transform: scale(2);
                opacity: 0;
                border-width: 0.5px;
            }
        }
    </style>
</head>
<body>
    
</body>
</html>
	<!-- logo code end -->









<style>
    /* Overlay Styles - Scoped specifically to the overlay */
    #pict-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.92);
        z-index: 9999;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        font-family: 'Arial', sans-serif;
    }

    #pict-overlay .overlay-logo {
        width: 100px;
        margin-bottom: 20px;
        animation: logoFloat 3s ease-in-out infinite, fadeIn 1s ease-in-out;
        filter:
            drop-shadow(0 0 5px rgba(255, 255, 255, 0.7))
            drop-shadow(0 0 10px rgba(255, 255, 255, 0.5))
            drop-shadow(0 0 15px rgba(255, 255, 255, 0.3));
        transition: all 0.5s ease;
    }

    #pict-overlay .overlay-logo:hover {
        transform: scale(1.05);
        filter:
            drop-shadow(0 0 8px rgba(255, 255, 255, 0.9))
            drop-shadow(0 0 15px rgba(255, 255, 255, 0.7))
            drop-shadow(0 0 20px rgba(255, 255, 255, 0.5));
    }

    #pict-overlay .overlay-content {
        width: 80%;
        max-width: 1000px;
        height: 80vh;
        background: linear-gradient(145deg, #0F2D52 0%, #1A3E6F 100%);
        border-radius: 12px;
        padding: 0;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        animation: slideUp 0.8s ease-in-out;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    #pict-overlay .overlay-header {
        color: white;
        text-align: center;
        padding: 20px;
        font-size: 1.8em;
        text-transform: uppercase;
        background: rgba(15, 45, 82, 0.9);
        border-bottom: 2px solid #00B4B4;
        flex-shrink: 0; /* Ensures header doesn't shrink */
    }

    /* MODIFIED: New container for scrolling content with overflow-y: auto */
    #pict-overlay .scroll-container {
        flex-grow: 1; /* Takes up all available vertical space */
        overflow-y: auto; /* Re-enabled manual scrollbar */
        overflow-x: hidden;
        position: relative; /* For animation to work correctly */
    }

    /* MODIFIED: Pause animation on hover */
    #pict-overlay .scroll-container:hover .overlay-sections {
        animation-play-state: paused;
    }

    #pict-overlay .overlay-sections {
        padding: 20px;
        /* Removed position: absolute to allow normal flow */
        width: 100%;
        /* REMOVED: Continuous scroll animation */
        /* animation: slowScroll 30s linear infinite; */
    }

    #pict-overlay .overlay-section {
        background-color: white;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

    #pict-overlay .overlay-section:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    }

    #pict-overlay .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    #pict-overlay .section-title {
        color: #0F2D52;
        font-size: 1.3em;
        font-weight: bold;
        padding-bottom: 8px;
        border-bottom: 2px solid #00B4B4;
    }

    #pict-overlay .section-btn {
        background: linear-gradient(to right, #0F2D52, #1A3E6F);
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 20px;
        font-size: 0.9em;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        box-shadow: 0 0px 5px rgba(0, 0, 0, 0.2);
        position: relative;
        overflow: hidden;
    }

    #pict-overlay .section-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(46, 2, 2, 0.77), transparent);
        transition: 0.5s;
    }

    #pict-overlay .section-btn:hover {
        background: linear-gradient(to right, #0c274dff, #0F2D52);
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    }

    #pict-overlay .section-btn:hover::before {
        left: 100%;
    }

    #pict-overlay .section-links {
        list-style-type: none;
        padding: 0;
        margin: 0;
    }

    #pict-overlay .section-links li {
        margin-bottom: 10px;
        padding: 8px 12px;
        background-color: #F5F7FA;
        border-radius: 5px;
        transition: all 0.2s ease;
        border-left: 3px solid #00B4B4;
    }

    #pict-overlay .section-links li:hover {
        background-color: #95acbdff;
        transform: translateX(5px);
    }

    #pict-overlay .section-links a {
        color: #0F2D52;
        text-decoration: none;
        font-weight: 500;
        display: block;
        transition: color 0.3s ease;
    }

    #pict-overlay .section-links a:hover {
        color: #042727ff;
    }

    #pict-overlay .overlay-footer {
        text-align: center;
        padding: 15px;
        background: rgba(15, 45, 82, 0.9);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        flex-shrink: 0; /* Ensures footer doesn't shrink */
    }

    #pict-overlay .home-btn {
        background: linear-gradient(to right, #00B4B4, #008080);
        color: white;
        border: none;
        padding: 12px 35px;
        border-radius: 30px;
        font-size: 1.1em;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
        font-weight: bold;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        position: relative;
        overflow: hidden;
    }

    #pict-overlay .home-btn::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 5px;
        height: 5px;
        background: rgba(255, 255, 255, 0.5);
        opacity: 0;
        border-radius: 100%;
        transform: scale(1, 1) translate(-50%);
        transform-origin: 50% 50%;
    }

    #pict-overlay .home-btn:hover {
        background: linear-gradient(to right, #008080, #006666);
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
    }

    #pict-overlay .home-btn:focus:not(:active)::after {
        animation: ripple 1s ease-out;
    }

    /* Animations */
    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes logoFloat {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }

    @keyframes ripple {
        0% {
            transform: scale(0, 0);
            opacity: 1;
        }
        20% {
            transform: scale(25, 25);
            opacity: 1;
        }
        100% {
            opacity: 0;
            transform: scale(40, 40);
        }
    }

    /* Responsive adjustments */
    @media (max-width: 992px) {
        #pict-overlay .overlay-content {
            width: 90%;
        }
    }

    @media (max-width: 768px) {
        #pict-overlay .overlay-content {
            width: 95%;
            height: 90vh;
        }

        #pict-overlay .overlay-logo {
            width: 90px;
            margin-bottom: 15px;
        }

        #pict-overlay .overlay-header {
            font-size: 1.5em;
            padding: 15px;
        }

        #pict-overlay .overlay-section {
            padding: 12px;
            margin-bottom: 15px;
        }

        #pict-overlay .section-title {
            font-size: 1.2em;
        }

        #pict-overlay .section-btn {
            padding: 6px 12px;
            font-size: 0.8em;
            white-space: nowrap;
        }

        #pict-overlay .section-links li {
            padding: 8px 10px;
            margin-bottom: 8px;
        }

        #pict-overlay .home-btn {
            padding: 10px 25px;
            font-size: 1em;
        }
    }

    @media (max-width: 576px) {
        #pict-overlay .overlay-content {
            height: 95vh;
        }

        #pict-overlay .overlay-header {
            font-size: 1.3em;
            padding: 12px;
        }

        #pict-overlay .section-header {
            flex-direction: column;
            align-items: flex-start;
        }

        #pict-overlay .section-title {
            margin-bottom: 8px;
        }

        #pict-overlay .section-btn {
            margin-top: 5px;
            width: 100%;
            text-align: center;
        }

        #pict-overlay .section-links li {
            font-size: 0.9em;
        }
    }

    /* Add this to modify visited link colors */
    #pict-overlay .section-links a:visited {
        color: #0A246A !important;
    }

    #pict-overlay .section-links a {
        color: #0F2D52;
        text-decoration: none;
        font-weight: 500;
        display: block;
        transition: color 0.3s ease;
    }
</style>

<script>
    // Function to set a cookie
    function setCookie(name, value, days) {
        var expires = "";
        if (days) {
            var date = new Date();
            date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
            expires = "; expires=" + date.toUTCString();
        }
        document.cookie = name + "=" + (value || "") + expires + "; path=/";
    }

    // Function to get a cookie
    function getCookie(name) {
        var nameEQ = name + "=";
        var ca = document.cookie.split(';');
        for (var i = 0; i < ca.length; i++) {
            var c = ca[i];
            while (c.charAt(0) == ' ') c = c.substring(1, c.length);
            if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
        }
        return null;
    }

    // Close overlay function
    function closeOverlay() {
        document.getElementById('pict-overlay').style.display = 'none';
        // Set cookie for 1 day so overlay won't show again
        setCookie('overlayShown', 'true', 1);
    }

    // Show overlay after page loads only if cookie not set
    window.addEventListener('load', function() {
        if (!getCookie('overlayShown')) {
            setTimeout(function() {
                document.getElementById('pict-overlay').style.display = 'flex';
            }, 1000); // 1 second delay after page load
        }
    });

    // Optional: Close overlay when clicking outside content
    document.getElementById('pict-overlay').addEventListener('click', function(e) {
        if (e.target === this) {
            closeOverlay();
        }
    });
</script>



