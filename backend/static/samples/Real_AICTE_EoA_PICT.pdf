    position: absolute;
    top: 5%; /* 👈 text */
    left: 5%;
    color: #ffffff;
    z-index: 10;
    padding: 20px;
    border-radius: 12px;

    background-color: rgba(0, 0, 0, 0.46); /* 👈 background */
